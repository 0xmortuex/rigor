// rigor — developer CLI for the Rigor engine.
//
// Reads an HTML document on stdin and dumps the tokenizer's output stream,
// followed by any parse errors (with their spec names and byte offsets):
//
//     Get-Content page.html | rigor        (PowerShell)
//     rigor < page.html                    (cmd / sh)
//
// Mort has no argv access yet, so stdin is the whole interface for now.

import std.vec;
import engine.lib;
import engine.html.preprocess;
import engine.html.tokenizer;
import engine.html.tokens;
import engine.html.treebuilder;
import engine.html.tagnames;
import engine.dom.node;
import engine.dom.serialize;
import engine.css.preprocess as css_preprocess;
import engine.css.tokenizer as css_tokenizer;
import engine.css.tokens as css_tokens;
import engine.css.parser as css_parser;
import engine.css.stylesheet;
import engine.css.serialize as css_serialize;
import engine.style.computed;
import engine.style.cascade;
import engine.style.ua;
import engine.layout.box;
import engine.layout.flow;
import engine.layout.serialize as layout_serialize;
import engine.paint.canvas;
import engine.paint.paint;
import engine.paint.bmp;
import std.fs;

extern fn getchar() -> c_int;
extern fn putchar(character: c_int) -> c_int;

fn read_stdin() -> Vec<u8> {
    let buf: Vec<u8> = vec.new<u8>();
    loop {
        let c: c_int = getchar();
        if c < 0 {
            break;
        }
        vec.push(&buf, c as u8);
    }
    return move buf;
}

fn cstr_len(text: *u8) -> u64 {
    let length: u64 = 0;
    while text[length] != 0 as u8 {
        length = length + 1;
    }
    return length;
}

fn out_str(out: *Vec<u8>, text: *u8) -> void {
    let index: u64 = 0;
    while text[index] != 0 as u8 {
        vec.push(out, text[index]);
        index = index + 1;
    }
}

fn out_pool(out: *Vec<u8>, sink: *HtmlTokenSink, off: u64, length: u64) -> void {
    let view: []const u8 = tokens.pool_bytes(sink, off, length);
    for index: u64 in 0..length {
        vec.push(out, view[index]);
    }
}

fn out_u64(out: *Vec<u8>, value: u64) -> void {
    if value >= 10 {
        out_u64(out, value / 10);
    }
    vec.push(out, '0' + ((value % 10) as u8));
}

// The serialized tree already carries its own newlines, so it goes out
// verbatim rather than through the line-oriented helpers.
fn print_raw(text: *u8) -> void {
    let index: u64 = 0;
    while text[index] != 0 as u8 {
        putchar(text[index] as c_int);
        index = index + 1;
    }
}

fn out_line(out: *Vec<u8>) -> void {
    vec.push(out, 0 as u8);
    println((*out).data);
    vec.clear(out);
}

fn dump_token(out: *Vec<u8>, sink: *HtmlTokenSink, index: u64) -> void {
    let token: HtmlToken = tokens.get_token(sink, index);
    if token.kind == tokens.kind_chars() {
        out_str(out, "text    \"");
        out_pool(out, sink, token.data_off, token.data_len);
        out_str(out, "\"");
    } else if token.kind == tokens.kind_start_tag() {
        out_str(out, "start   <");
        out_pool(out, sink, token.data_off, token.data_len);
        for a: u64 in 0..token.attr_count {
            let attr: HtmlAttr = tokens.get_attr(sink, token.attr_first + a);
            out_str(out, " ");
            out_pool(out, sink, attr.name_off, attr.name_len);
            out_str(out, "=\"");
            out_pool(out, sink, attr.value_off, attr.value_len);
            out_str(out, "\"");
        }
        if token.self_closing {
            out_str(out, " /");
        }
        out_str(out, ">");
    } else if token.kind == tokens.kind_end_tag() {
        out_str(out, "end     </");
        out_pool(out, sink, token.data_off, token.data_len);
        out_str(out, ">");
    } else if token.kind == tokens.kind_comment() {
        out_str(out, "comment <!--");
        out_pool(out, sink, token.data_off, token.data_len);
        out_str(out, "-->");
    } else if token.kind == tokens.kind_doctype() {
        out_str(out, "doctype <!DOCTYPE");
        if token.has_name {
            out_str(out, " ");
            out_pool(out, sink, token.data_off, token.data_len);
        }
        if token.has_public {
            out_str(out, " PUBLIC \"");
            out_pool(out, sink, token.public_off, token.public_len);
            out_str(out, "\"");
        }
        if token.has_system {
            out_str(out, " SYSTEM \"");
            out_pool(out, sink, token.system_off, token.system_len);
            out_str(out, "\"");
        }
        out_str(out, ">");
        if token.force_quirks {
            out_str(out, "  (force-quirks)");
        }
    } else {
        out_str(out, "eof");
    }
    out_line(out);
}

// Collect the text of every <style> element in the document, in tree order,
// into one buffer — which is what the cascade will do too.
fn gather_style_text(doc: *DomDocument, out: *Vec<u8>, index: u64) -> void {
    let n: DomNode = node.get(doc, index);
    if n.kind == node.kind_element() && n.tag == tagnames.tag_style() {
        let child: u64 = n.first_child;
        while child != node.none() {
            let child_node: DomNode = node.get(doc, child);
            if child_node.kind == node.kind_text() {
                let text: []const u8 =
                node.bytes(doc, child_node.data_off, child_node.data_len);
                for step: u64 in 0..len(text) {
                    vec.push(out, text[step]);
                }
            }
            child = child_node.next_sibling;
        }
        vec.push(out, 10 as u8);
    }
    let child: u64 = n.first_child;
    while child != node.none() {
        gather_style_text(doc, out, child);
        let child_node: DomNode = node.get(doc, child);
        child = child_node.next_sibling;
    }
}

fn out_f64(out: *Vec<u8>, value: f64) -> void {
    let magnitude: f64 = value;
    if magnitude < 0.0 {
        out_str(out, "-");
        magnitude = 0.0 - magnitude;
    }
    // Round before splitting, so accumulated float error near a whole number
    // does not print as the integer below it.
    let scaled: u64 = (magnitude * 100.0 + 0.5) as u64;
    out_u64(out, scaled / 100);
    let hundredths: u64 = scaled % 100;
    if hundredths > 0 {
        out_str(out, ".");
        if hundredths < 10 {
            out_str(out, "0");
        }
        out_u64(out, hundredths);
    }
}

fn out_length(out: *Vec<u8>, length: StyleLength) -> void {
    if length.kind == computed.length_auto() {
        out_str(out, "auto");
        return;
    }
    out_f64(out, length.value);
    if length.kind == computed.length_percent() {
        out_str(out, "%");
    } else {
        out_str(out, "px");
    }
}

fn out_color(out: *Vec<u8>, color: StyleColor) -> void {
    if color.a == 0 as u8 {
        out_str(out, "transparent");
        return;
    }
    out_str(out, "rgb(");
    out_u64(out, color.r as u64);
    out_str(out, " ");
    out_u64(out, color.g as u64);
    out_str(out, " ");
    out_u64(out, color.b as u64);
    out_str(out, ")");
}

fn display_name(value: u8) -> *u8 {
    if value == computed.display_block() { return "block"; }
    if value == computed.display_inline() { return "inline"; }
    if value == computed.display_inline_block() { return "inline-block"; }
    if value == computed.display_list_item() { return "list-item"; }
    if value == computed.display_none() { return "none"; }
    if value == computed.display_table() { return "table"; }
    if value == computed.display_table_row() { return "table-row"; }
    if value == computed.display_table_cell() { return "table-cell"; }
    return "table-row-group";
}

// One line per element: its tag, then the computed values layout will read.
fn dump_styles(
out: *Vec<u8>,
doc: *DomDocument,
tree: *StyleTree,
index: u64,
depth: u64
) -> void {
    let element: DomNode = node.get(doc, index);
    if element.kind == node.kind_element() {
        let style: ComputedStyle = computed.get(tree, index);
        for step: u64 in 0..depth {
            out_str(out, "  ");
        }
        out_str(out, "<");
        let name: []const u8 = node.bytes(doc, element.name_off, element.name_len);
        for step: u64 in 0..len(name) {
            vec.push(out, name[step]);
        }
        out_str(out, ">  display:");
        out_str(out, display_name(style.display));
        out_str(out, " font:");
        out_f64(out, style.font_size);
        out_str(out, "px/");
        out_u64(out, style.font_weight as u64);
        out_str(out, " color:");
        out_color(out, style.color);
        if style.background_color.a != 0 as u8 {
            out_str(out, " background:");
            out_color(out, style.background_color);
        }
        out_str(out, " margin:");
        out_length(out, style.margin_top);
        out_str(out, " ");
        out_length(out, style.margin_right);
        out_str(out, " ");
        out_length(out, style.margin_bottom);
        out_str(out, " ");
        out_length(out, style.margin_left);
        if style.border_top_width > 0.0 {
            out_str(out, " border:");
            out_f64(out, style.border_top_width);
            out_str(out, "px");
        }
        if style.width.kind != computed.length_auto() {
            out_str(out, " width:");
            out_length(out, style.width);
        }
        out_line(out);
    }
    let child: u64 = element.first_child;
    while child != node.none() {
        let next_depth: u64 = depth;
        if element.kind == node.kind_element() {
            next_depth = depth + 1;
        }
        dump_styles(out, doc, tree, child, next_depth);
        child = node.get(doc, child).next_sibling;
    }
}

fn main() -> int {
    let raw: Vec<u8> = read_stdin();
    // Raw document bytes, so the byte stream decoder runs first.
    let sink: HtmlTokenSink = tokens.new_sink();
    let normalized: Vec<u8> =
    preprocess.decode_and_normalize(raw.data as *const u8, raw.length, &sink);
    let doc: DomDocument = node.new_document();
    treebuilder.parse(
    normalized.data as *const u8, normalized.length, &doc, &sink);

    let out: Vec<u8> = vec.new<u8>();
    out_str(&out, "rigor ");
    out_str(&out, lib.version());
    out_str(&out, " — tokens");
    out_line(&out);
    for index: u64 in 0..tokens.token_count(&sink) {
        dump_token(&out, &sink, index);
    }
    out_str(&out, "-- tree --");
    out_line(&out);
    let tree: Vec<u8> = serialize.document(&doc);
    for index: u64 in 0..tree.length {
        vec.push(&out, tree.data[index]);
    }
    vec.push(&out, 0 as u8);
    print_raw(out.data);
    vec.clear(&out);

    // Author styles: every <style> element's text, concatenated in tree order.
    let style_text: Vec<u8> = vec.new<u8>();
    gather_style_text(&doc, &style_text, 0);
    let css_normalized: Vec<u8> =
    css_preprocess.normalize(style_text.data as *const u8, style_text.length);
    let css_sink: CssTokenSink = css_tokens.new_sink();
    let css_t: CssTokenizer =
    css_tokenizer.new(css_normalized.data as *const u8, css_normalized.length);
    css_tokenizer.run(&css_t, &css_sink);
    let sheet: CssStylesheet = stylesheet.new_stylesheet();
    css_parser.parse_stylesheet(&sheet, &css_sink);

    if stylesheet.rule_count(&sheet) > 0 {
        out_str(&out, "-- stylesheet --");
        out_line(&out);
        let css_text: Vec<u8> = css_serialize.stylesheet_text(&sheet, &css_sink);
        for index: u64 in 0..css_text.length {
            vec.push(&out, css_text.data[index]);
        }
        vec.push(&out, 0 as u8);
        print_raw(out.data);
        vec.clear(&out);
        vec.destroy(&css_text);
    }

    // The user-agent stylesheet, parsed exactly like the author's.
    let ua_source: *u8 = ua.stylesheet_text();
    let ua_normalized: Vec<u8> =
    css_preprocess.normalize(ua_source as *const u8, cstr_len(ua_source));
    let ua_sink: CssTokenSink = css_tokens.new_sink();
    let ua_t: CssTokenizer =
    css_tokenizer.new(ua_normalized.data as *const u8, ua_normalized.length);
    css_tokenizer.run(&ua_t, &ua_sink);
    let ua_sheet: CssStylesheet = stylesheet.new_stylesheet();
    css_parser.parse_stylesheet(&ua_sheet, &ua_sink);

    let tree_styles: StyleTree = computed.new_tree(node.node_count(&doc));
    cascade.compute(&doc, &ua_sheet, &ua_sink, &sheet, &css_sink, &tree_styles);

    out_str(&out, "-- computed style --");
    out_line(&out);
    dump_styles(&out, &doc, &tree_styles, 0, 0);

    // Lay the document out at a conventional 800px viewport.
    let boxes: LayoutTree = box.new_tree();
    flow.layout(&doc, &tree_styles, &boxes, 800.0);
    out_str(&out, "-- layout --");
    out_line(&out);
    let layout_text: Vec<u8> = layout_serialize.tree_text(&boxes, &doc);
    for index: u64 in 0..layout_text.length {
        vec.push(&out, layout_text.data[index]);
    }
    vec.push(&out, 0 as u8);
    print_raw(out.data);
    vec.clear(&out);
    vec.destroy(&layout_text);

    // Render to rigor.bmp, sized to the document.
    let page_height: u64 = (flow.document_height(&boxes) + 0.5) as u64;
    if page_height < 1 {
        page_height = 1;
    }
    let target: Canvas = canvas.new_canvas(800, page_height);
    paint.paint(&target, &boxes, &tree_styles);
    let image: Vec<u8> = bmp.encode(&target);
    let output: File = fs.open("rigor.bmp", "wb");
    if fs.is_open(&output) {
        fs.write(&output, vec.as_const_slice(&image));
        fs.close(&output);
        out_str(&out, "-- painted --");
        out_line(&out);
        out_str(&out, "rigor.bmp  800x");
        out_u64(&out, page_height);
        out_line(&out);
    } else {
        out_str(&out, "-- paint failed: could not open rigor.bmp --");
        out_line(&out);
    }
    vec.destroy(&image);
    canvas.destroy(&target);
    box.destroy(&boxes);

    computed.destroy(&tree_styles);
    stylesheet.destroy(&ua_sheet);
    css_tokens.destroy(&ua_sink);
    vec.destroy(&ua_normalized);
    stylesheet.destroy(&sheet);
    css_tokens.destroy(&css_sink);
    vec.destroy(&css_normalized);
    vec.destroy(&style_text);

    let errors: u64 = tokens.error_count(&sink);
    if errors > 0 {
        out_str(&out, "-- parse errors --");
        out_line(&out);
        for index: u64 in 0..errors {
            let e: HtmlParseError = tokens.get_error(&sink, index);
            out_str(&out, "error   ");
            out_str(&out, tokens.error_name(e.code));
            out_str(&out, " @ byte ");
            out_u64(&out, e.pos);
            out_line(&out);
        }
    }
    return 0;
}
