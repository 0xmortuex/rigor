// Spec-behavior tests for HTML tree construction (WHATWG HTML §13.2.6).
//
// Expected trees use the html5lib serialization that engine.dom.serialize
// emits, so these read the same way the conformance suites do.

import std.vec;
import std.string;
import engine.html.preprocess;
import engine.html.treebuilder;
import engine.html.tokens;
import engine.dom.node;
import engine.dom.serialize;

fn tree_of(source: *u8) -> Vec<u8> {
    let sink: HtmlTokenSink = tokens.new_sink();
    let normalized: Vec<u8> =
    preprocess.normalize(source as *const u8, str_len(source), &sink);
    let doc: DomDocument = node.new_document();
    treebuilder.parse(
    normalized.data as *const u8, normalized.length, &doc, &sink);
    let text: Vec<u8> = serialize.document(&doc);
    node.destroy(&doc);
    tokens.destroy(&sink);
    vec.destroy(&normalized);
    return move text;
}

fn tree_is(source: *u8, expected: *u8) -> bool {
    let text: Vec<u8> = tree_of(source);
    let want: u64 = str_len(expected);
    let ok: bool = text.length == want;
    if ok {
        for index: u64 in 0..want {
            if text.data[index] != expected[index] {
                ok = false;
            }
        }
    }
    vec.destroy(&text);
    return ok;
}

test "implied html, head and body" {
    assert(tree_is("hello",
    "| <html>\n|   <head>\n|   <body>\n|     \"hello\"\n"));
}

test "doctype is a document child and clears quirks" {
    assert(tree_is("<!DOCTYPE html><p>x",
    "| <!DOCTYPE html>\n| <html>\n|   <head>\n|   <body>\n|     <p>\n|       \"x\"\n"));
}

test "missing doctype sets quirks mode" {
    let sink: HtmlTokenSink = tokens.new_sink();
    let source: *u8 = "<p>x";
    let normalized: Vec<u8> =
    preprocess.normalize(source as *const u8, str_len(source), &sink);
    let doc: DomDocument = node.new_document();
    treebuilder.parse(
    normalized.data as *const u8, normalized.length, &doc, &sink);
    assert(node.is_quirks(&doc));
    node.destroy(&doc);
    tokens.destroy(&sink);
    vec.destroy(&normalized);
}

test "attributes land on the element, sorted when serialized" {
    assert(tree_is("<p id=a class=b>",
    "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       class=\"b\"\n|       id=\"a\"\n"));
}

test "head metadata goes in head, content opens body" {
    assert(tree_is("<title>T</title><p>x",
    "| <html>\n|   <head>\n|     <title>\n|       \"T\"\n|   <body>\n|     <p>\n|       \"x\"\n"));
}

test "an open p is closed by a following block element" {
    assert(tree_is("<p>one<p>two",
    "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       \"one\"\n|     <p>\n|       \"two\"\n"));
}

test "list items close each other" {
    assert(tree_is("<ul><li>a<li>b</ul>",
    "| <html>\n|   <head>\n|   <body>\n|     <ul>\n|       <li>\n|         \"a\"\n|       <li>\n|         \"b\"\n"));
}

test "unclosed elements are closed at end of file" {
    assert(tree_is("<div><span>x",
    "| <html>\n|   <head>\n|   <body>\n|     <div>\n|       <span>\n|         \"x\"\n"));
}

test "stray end tag for an unopened element is ignored" {
    assert(tree_is("<p>x</div>y",
    "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       \"xy\"\n"));
}

test "adoption agency repairs misnested formatting" {
    // The canonical case: <b> is reopened inside <p> and the trailing text
    // stays outside it.
    assert(tree_is("<b>1<p>2</b>3</p>",
    "| <html>\n|   <head>\n|   <body>\n|     <b>\n|       \"1\"\n|     <p>\n|       <b>\n|         \"2\"\n|       \"3\"\n"));
}

test "a block nests inside an open formatting element" {
    // No end tag crosses the block, so no adoption happens and <div> simply
    // becomes a child of the still-open <b>.
    assert(tree_is("<b>1<div>2</div>3</b>",
    "| <html>\n|   <head>\n|   <body>\n|     <b>\n|       \"1\"\n|       <div>\n|         \"2\"\n|       \"3\"\n"));
}

test "formatting elements are reconstructed after their block closes" {
    // </p> pops <b> off the stack but leaves it in the active formatting
    // list, so the following text reopens it.
    assert(tree_is("<p><b>1</p>2",
    "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       <b>\n|         \"1\"\n|     <b>\n|       \"2\"\n"));
}

test "nested anchors are split by the adoption agency" {
    assert(tree_is("<a><p></a></p>",
    "| <html>\n|   <head>\n|   <body>\n|     <a>\n|     <p>\n|       <a>\n"));
}

test "void elements take no children" {
    assert(tree_is("<p>a<br>b",
    "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       \"a\"\n|       <br>\n|       \"b\"\n"));
}

test "comments are nodes in the tree" {
    assert(tree_is("<p><!--note--></p>",
    "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       <!-- note -->\n"));
}

test "a comment before html is a document child" {
    assert(tree_is("<!--top--><p>x",
    "| <!-- top -->\n| <html>\n|   <head>\n|   <body>\n|     <p>\n|       \"x\"\n"));
}

test "rawtext content is text, not markup" {
    assert(tree_is("<style>p{}</style><p>x",
    "| <html>\n|   <head>\n|     <style>\n|       \"p{}\"\n|   <body>\n|     <p>\n|       \"x\"\n"));
}

test "character references are decoded into text nodes" {
    assert(tree_is("<p>a&amp;b",
    "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       \"a&b\"\n"));
}

test "duplicate html and body attributes merge onto the originals" {
    assert(tree_is("<html lang=en><body id=main><body id=other class=c>x",
    "| <html>\n|   lang=\"en\"\n|   <head>\n|   <body>\n|     class=\"c\"\n|     id=\"main\"\n|     \"x\"\n"));
}

test "heading closes an open heading of any level" {
    assert(tree_is("<h1>a<h2>b",
    "| <html>\n|   <head>\n|   <body>\n|     <h1>\n|       \"a\"\n|     <h2>\n|       \"b\"\n"));
}

test "a newline immediately after pre is dropped" {
    assert(tree_is("<pre>\nx</pre>",
    "| <html>\n|   <head>\n|   <body>\n|     <pre>\n|       \"x\"\n"));
}

test "table rows get an implied tbody" {
    assert(tree_is("<table><tr><td>a</table>",
    "| <html>\n|   <head>\n|   <body>\n|     <table>\n|       <tbody>\n|         <tr>\n|           <td>\n|             \"a\"\n"));
}

test "explicit table sections are kept" {
    assert(tree_is("<table><thead><tr><th>h</table>",
    "| <html>\n|   <head>\n|   <body>\n|     <table>\n|       <thead>\n|         <tr>\n|           <th>\n|             \"h\"\n"));
}

test "text inside a table is foster parented before it" {
    // Stray character data cannot live in a table, so it is placed
    // immediately before the table rather than dropped.
    assert(tree_is("<table>stray<tr><td>a</table>",
    "| <html>\n|   <head>\n|   <body>\n|     \"stray\"\n|     <table>\n|       <tbody>\n|         <tr>\n|           <td>\n|             \"a\"\n"));
}

test "a nested table start tag closes the outer table" {
    assert(tree_is("<table><tr><td>a<table><tr><td>b",
    "| <html>\n|   <head>\n|   <body>\n|     <table>\n|       <tbody>\n|         <tr>\n|           <td>\n|             \"a\"\n|             <table>\n|               <tbody>\n|                 <tr>\n|                   <td>\n|                     \"b\"\n"));
}

test "caption content stays inside the caption" {
    assert(tree_is("<table><caption>c</caption><tr><td>a</table>",
    "| <html>\n|   <head>\n|   <body>\n|     <table>\n|       <caption>\n|         \"c\"\n|       <tbody>\n|         <tr>\n|           <td>\n|             \"a\"\n"));
}

test "a document ending inside script still gets a body" {
    assert(tree_is("<script>a",
    "| <html>\n|   <head>\n|     <script>\n|       \"a\"\n|   <body>\n"));
}

test "svg and mathml elements carry their namespace" {
    assert(tree_is("<math><mi>x</mi></math>",
    "| <html>\n|   <head>\n|   <body>\n|     <math math>\n|       <math mi>\n|         \"x\"\n"));
}

test "svg tag names are restored to their camel case" {
    assert(tree_is("<svg><lineargradient/><textpath/></svg>",
    "| <html>\n|   <head>\n|   <body>\n|     <svg svg>\n|       <svg linearGradient>\n|       <svg textPath>\n"));
}

test "inside an integration point, names follow html rules again" {
    // foreignObject is an HTML integration point, so its children are HTML
    // elements and get no SVG case fix-up.
    assert(tree_is("<svg><foreignobject><lineargradient/></foreignobject></svg>",
    "| <html>\n|   <head>\n|   <body>\n|     <svg svg>\n|       <svg foreignObject>\n|         <lineargradient>\n"));
}

test "svg attribute names are restored to their camel case" {
    assert(tree_is("<svg viewbox=\"0 0 1 1\"></svg>",
    "| <html>\n|   <head>\n|   <body>\n|     <svg svg>\n|       viewBox=\"0 0 1 1\"\n"));
}

test "foreign attributes gain their xml namespace prefix" {
    assert(tree_is("<svg><a xlink:href=\"x\"></a></svg>",
    "| <html>\n|   <head>\n|   <body>\n|     <svg svg>\n|       <svg a>\n|         xlink href=\"x\"\n"));
}

test "a self-closing tag really closes in foreign content" {
    // Unlike in HTML, where the solidus is ignored.
    assert(tree_is("<svg><path/><circle/></svg>",
    "| <html>\n|   <head>\n|   <body>\n|     <svg svg>\n|       <svg path>\n|       <svg circle>\n"));
}

test "an html integration point holds html children" {
    assert(tree_is("<svg><foreignobject><p>hi</p></foreignobject></svg>",
    "| <html>\n|   <head>\n|   <body>\n|     <svg svg>\n|       <svg foreignObject>\n|         <p>\n|           \"hi\"\n"));
}

test "a mathml text integration point holds html text" {
    assert(tree_is("<math><mtext><b>x</b></mtext></math>",
    "| <html>\n|   <head>\n|   <body>\n|     <math math>\n|       <math mtext>\n|         <b>\n|           \"x\"\n"));
}

test "an html start tag breaks out of foreign content" {
    // <p> is on the breakout list, so it closes the svg subtree entirely
    // rather than becoming an SVG element.
    assert(tree_is("<svg><circle></circle><p>out",
    "| <html>\n|   <head>\n|   <body>\n|     <svg svg>\n|       <svg circle>\n|     <p>\n|       \"out\"\n"));
}

test "a cdata section inside foreign content is text" {
    assert(tree_is("<svg><![CDATA[a<b>c]]></svg>",
    "| <html>\n|   <head>\n|   <body>\n|     <svg svg>\n|       \"a<b>c\"\n"));
}

test "a cdata section in html content is a bogus comment" {
    assert(tree_is("<p><![CDATA[x]]></p>",
    "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       <!-- [CDATA[x]] -->\n"));
}

test "a select holds options and optgroups" {
    assert(tree_is("<select><option>a<option>b</select>",
    "| <html>\n|   <head>\n|   <body>\n|     <select>\n|       <option>\n|         \"a\"\n|       <option>\n|         \"b\"\n"));
}

test "an option closes the previous one" {
    assert(tree_is("<select><optgroup><option>a<optgroup><option>b</select>",
    "| <html>\n|   <head>\n|   <body>\n|     <select>\n|       <optgroup>\n|         <option>\n|           \"a\"\n|       <optgroup>\n|         <option>\n|           \"b\"\n"));
}

test "markup with no business in a select is dropped" {
    // Almost everything that is not option, optgroup or hr is a parse error
    // inside a select, and the token is ignored rather than breaking out.
    assert(tree_is("<select><div>x</div><option>a</select>",
    "| <html>\n|   <head>\n|   <body>\n|     <select>\n|       \"x\"\n|       <option>\n|         \"a\"\n"));
}

test "a nested select closes the outer one" {
    assert(tree_is("<select><option>a<select><option>b",
    "| <html>\n|   <head>\n|   <body>\n|     <select>\n|       <option>\n|         \"a\"\n|     <option>\n|       \"b\"\n"));
}

test "an input closes an open select" {
    assert(tree_is("<select><option>a<input>b",
    "| <html>\n|   <head>\n|   <body>\n|     <select>\n|       <option>\n|         \"a\"\n|     <input>\n|     \"b\"\n"));
}

test "table markup closes a select inside a table" {
    assert(tree_is("<table><tr><td><select><option>a<tr><td>b",
    "| <html>\n|   <head>\n|   <body>\n|     <table>\n|       <tbody>\n|         <tr>\n|           <td>\n|             <select>\n|               <option>\n|                 \"a\"\n|         <tr>\n|           <td>\n|             \"b\"\n"));
}

test "an integration point stops a scope search" {
    // </div> cannot reach the div outside the SVG, because foreignObject is
    // a scope boundary, so it is ignored and the text stays inside.
    assert(tree_is("<div><svg><foreignobject><math></div>a",
    "| <html>\n|   <head>\n|   <body>\n|     <div>\n|       <svg svg>\n|         <svg foreignObject>\n|           <math math>\n|             \"a\"\n"));
}

test "unknown elements are ordinary elements" {
    assert(tree_is("<my-widget>x</my-widget>",
    "| <html>\n|   <head>\n|   <body>\n|     <my-widget>\n|       \"x\"\n"));
}

test "template children go into the contents fragment" {
    assert(tree_is("<template><div>a</div></template><p>after",
    "| <html>\n|   <head>\n|     <template>\n|       content\n|         <div>\n|           \"a\"\n|   <body>\n|     <p>\n|       \"after\"\n"));
}

test "an unclosed template still lets the document finish" {
    assert(tree_is("<template><div>",
    "| <html>\n|   <head>\n|     <template>\n|       content\n|         <div>\n|   <body>\n"));
}

test "table markup inside a template keeps its shape" {
    assert(tree_is("<body><template><tr><td>a",
    "| <html>\n|   <head>\n|   <body>\n|     <template>\n|       content\n|         <tr>\n|           <td>\n|             \"a\"\n"));
}

test "content fostered out of a table stays inside the template" {
    // The table is not really an ancestor here: the template is nearer, so
    // the div lands in the template contents rather than beside the table.
    assert(tree_is("<body><template><tr><div></div></tr></template>",
    "| <html>\n|   <head>\n|   <body>\n|     <template>\n|       content\n|         <tr>\n|         <div>\n"));
}

test "a template cannot change the document around it" {
    // <html> and <body> attributes are merged onto the originals normally,
    // but template contents are sealed off from the document.
    assert(tree_is("<html a=b><template><html c=d>",
    "| <html>\n|   a=\"b\"\n|   <head>\n|     <template>\n|       content\n|   <body>\n"));
}

test "templates nest" {
    assert(tree_is("<template><template><div>",
    "| <html>\n|   <head>\n|     <template>\n|       content\n|         <template>\n|           content\n|             <div>\n|   <body>\n"));
}

test "a template inside a select is not flattened" {
    assert(tree_is("<select><template><option></option></template></select>",
    "| <html>\n|   <head>\n|   <body>\n|     <select>\n|       <template>\n|         content\n|           <option>\n"));
}

// §13.4: parse `source` as though it appeared inside `context`, and serialize
// the result the way html5lib prints a fragment — without a root element.
fn fragment_is(source: *u8, context: *u8, namespace: u8, expected: *u8) -> bool {
    let sink: HtmlTokenSink = tokens.new_sink();
    let normalized: Vec<u8> =
    preprocess.normalize(source as *const u8, str_len(source), &sink);
    let doc: DomDocument = node.new_document();
    let root: u64 = treebuilder.parse_fragment(
    normalized.data as *const u8, normalized.length, &doc, &sink,
    slice(context as *const u8, str_len(context)), namespace);
    let text: Vec<u8> = serialize.fragment(&doc, root);
    let want: u64 = str_len(expected);
    let ok: bool = text.length == want;
    if ok {
        for index: u64 in 0..want {
            if text.data[index] != expected[index] {
                ok = false;
            }
        }
    }
    vec.destroy(&text);
    node.destroy(&doc);
    tokens.destroy(&sink);
    vec.destroy(&normalized);
    return ok;
}

test "a fragment has no implied html, head or body" {
    assert(fragment_is("<p>x", "div", node.ns_html(),
    "| <p>\n|   \"x\"\n"));
}

test "a fragment is parsed in its context element" {
    // A bare <td> is dropped in a document, but inside a <tr> it is a cell.
    assert(fragment_is("<td>a", "tr", node.ns_html(),
    "| <td>\n|   \"a\"\n"));
    assert(tree_is("<td>a",
    "| <html>\n|   <head>\n|   <body>\n|     \"a\"\n"));
}

test "a fragment in a foreign context starts in foreign content" {
    assert(fragment_is("<circle>", "svg", node.ns_svg(),
    "| <svg circle>\n"));
}

test "the context element sets the tokenizer state" {
    // Inside <title> the markup is RCDATA, so <b> is text rather than a tag.
    assert(fragment_is("<b>x", "title", node.ns_html(), "| \"<b>x\"\n"));
    assert(fragment_is("<b>x", "div", node.ns_html(),
    "| <b>\n|   \"x\"\n"));
}

test "a fragment in a template context is in template contents" {
    assert(fragment_is("<td>a", "template", node.ns_html(),
    "| <td>\n|   \"a\"\n"));
}

test "an end tag with nothing to close is dropped in a fragment" {
    assert(fragment_is("</frameset><frame>", "frameset", node.ns_html(),
    "| <frame>\n"));
}
