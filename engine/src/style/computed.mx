// Computed style — CSS Cascade §4 "value processing".
//
// One ComputedStyle per DOM node, held in a Vec indexed by node index, so
// looking up an element's style is an array read. The property set is the one
// block and inline layout actually needs; it grows as layout does, and every
// property here has a documented initial value and inheritance behaviour from
// its own spec.
//
// Lengths are stored resolved to pixels wherever that is possible at compute
// time (em, rem, pt and friends all resolve against a known font size).
// Percentages cannot resolve until layout knows the containing block, so they
// survive as percentages; `auto` is its own kind rather than a magic number.
module engine.style.computed;

import std.vec;

// --- Lengths -----------------------------------------------------------------

pub fn length_auto() -> u8 { return 0 as u8; }
pub fn length_px() -> u8 { return 1 as u8; }
pub fn length_percent() -> u8 { return 2 as u8; }

struct StyleLength {
    kind: u8,
    value: f64,
}

pub fn auto_length() -> StyleLength {
    return StyleLength { kind: length_auto(), value: 0.0 };
}

pub fn px(value: f64) -> StyleLength {
    return StyleLength { kind: length_px(), value: value };
}

pub fn percent(value: f64) -> StyleLength {
    return StyleLength { kind: length_percent(), value: value };
}

pub fn zero_length() -> StyleLength {
    return StyleLength { kind: length_px(), value: 0.0 };
}

// --- Colors ------------------------------------------------------------------

struct StyleColor {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
}

pub fn rgba(r: u8, g: u8, b: u8, a: u8) -> StyleColor {
    return StyleColor { r: r, g: g, b: b, a: a };
}

pub fn transparent() -> StyleColor {
    return StyleColor { r: 0 as u8, g: 0 as u8, b: 0 as u8, a: 0 as u8 };
}

pub fn black() -> StyleColor {
    return StyleColor { r: 0 as u8, g: 0 as u8, b: 0 as u8, a: 255 as u8 };
}

// --- Keyword values ----------------------------------------------------------

// display (CSS Display §2). Only the outer/inner combinations layout supports.
pub fn display_inline() -> u8 { return 0 as u8; }
pub fn display_block() -> u8 { return 1 as u8; }
pub fn display_inline_block() -> u8 { return 2 as u8; }
pub fn display_list_item() -> u8 { return 3 as u8; }
pub fn display_none() -> u8 { return 4 as u8; }
pub fn display_table() -> u8 { return 5 as u8; }
pub fn display_table_row() -> u8 { return 6 as u8; }
pub fn display_table_cell() -> u8 { return 7 as u8; }
pub fn display_table_row_group() -> u8 { return 8 as u8; }

// font-style
pub fn font_style_normal() -> u8 { return 0 as u8; }
pub fn font_style_italic() -> u8 { return 1 as u8; }

// text-align
pub fn text_align_left() -> u8 { return 0 as u8; }
pub fn text_align_right() -> u8 { return 1 as u8; }
pub fn text_align_center() -> u8 { return 2 as u8; }
pub fn text_align_justify() -> u8 { return 3 as u8; }

// white-space
pub fn white_space_normal() -> u8 { return 0 as u8; }
pub fn white_space_pre() -> u8 { return 1 as u8; }
pub fn white_space_nowrap() -> u8 { return 2 as u8; }

// border-style (CSS Backgrounds §4). Only the ones paint distinguishes.
pub fn border_none() -> u8 { return 0 as u8; }
pub fn border_solid() -> u8 { return 1 as u8; }
pub fn border_dashed() -> u8 { return 2 as u8; }
pub fn border_dotted() -> u8 { return 3 as u8; }
pub fn border_double() -> u8 { return 4 as u8; }

struct ComputedStyle {
    display: u8,
    color: StyleColor,
    background_color: StyleColor,

    margin_top: StyleLength,
    margin_right: StyleLength,
    margin_bottom: StyleLength,
    margin_left: StyleLength,

    padding_top: StyleLength,
    padding_right: StyleLength,
    padding_bottom: StyleLength,
    padding_left: StyleLength,

    border_top_width: f64,
    border_right_width: f64,
    border_bottom_width: f64,
    border_left_width: f64,
    border_top_style: u8,
    border_right_style: u8,
    border_bottom_style: u8,
    border_left_style: u8,
    border_top_color: StyleColor,
    border_right_color: StyleColor,
    border_bottom_color: StyleColor,
    border_left_color: StyleColor,

    width: StyleLength,
    height: StyleLength,

    font_size: f64,
    font_weight: u32,
    font_style: u8,
    // Resolved to pixels; a unitless line-height multiplies the font size,
    // which is already known by the time it is computed.
    line_height: f64,

    text_align: u8,
    white_space: u8,
}

// The initial value of every property, per its own spec. This is what the
// root element starts from and what a non-inherited property resets to.
pub fn initial_style() -> ComputedStyle {
    return ComputedStyle {
        display: display_inline(),
        color: black(),
        background_color: transparent(),

        margin_top: zero_length(),
        margin_right: zero_length(),
        margin_bottom: zero_length(),
        margin_left: zero_length(),

        padding_top: zero_length(),
        padding_right: zero_length(),
        padding_bottom: zero_length(),
        padding_left: zero_length(),

        border_top_width: 0.0,
        border_right_width: 0.0,
        border_bottom_width: 0.0,
        border_left_width: 0.0,
        border_top_style: border_none(),
        border_right_style: border_none(),
        border_bottom_style: border_none(),
        border_left_style: border_none(),
        border_top_color: black(),
        border_right_color: black(),
        border_bottom_color: black(),
        border_left_color: black(),

        width: auto_length(),
        height: auto_length(),

        font_size: 16.0,
        font_weight: 400 as u32,
        font_style: font_style_normal(),
        line_height: 16.0 * 1.2,

        text_align: text_align_left(),
        white_space: white_space_normal(),
    };
}

// A child's starting point: inherited properties carry over, everything else
// resets to its initial value (CSS Cascade §7).
pub fn inherit_from(parent: ComputedStyle) -> ComputedStyle {
    let style: ComputedStyle = initial_style();
    style.color = parent.color;
    style.font_size = parent.font_size;
    style.font_weight = parent.font_weight;
    style.font_style = parent.font_style;
    style.line_height = parent.line_height;
    style.text_align = parent.text_align;
    style.white_space = parent.white_space;
    return style;
}

// Styles for a whole document, indexed by DOM node index.
resource struct StyleTree {
    styles: Vec<ComputedStyle>,
}

pub fn new_tree(node_count: u64) -> StyleTree {
    let tree: StyleTree =
        StyleTree { styles: vec.with_capacity<ComputedStyle>(node_count + 1) };
    for index: u64 in 0..node_count {
        vec.push(&tree.styles, initial_style());
    }
    return move tree;
}

pub fn destroy(tree: *StyleTree) -> void {
    vec.destroy(&(*tree).styles);
}

pub fn get(tree: *StyleTree, index: u64) -> ComputedStyle {
    match vec.get(&(*tree).styles, index) {
        Option<ComputedStyle>.Some(style) => { return style; },
        Option<ComputedStyle>.None => { return initial_style(); },
    }
}

pub fn set(tree: *StyleTree, index: u64, style: ComputedStyle) -> void {
    vec.set(&(*tree).styles, index, style);
}
