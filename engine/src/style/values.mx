// Parsing property values out of a declaration's token range.
//
// A declaration keeps its value as tokens; this module turns those tokens into
// the typed values ComputedStyle holds. Parsing is per property and happens
// only for declarations that win the cascade, which is why the tokens were
// kept rather than eagerly converted.
//
// Colors cover hex (3, 4, 6 and 8 digit), rgb()/rgba(), and the named colors.
// The named table is the common subset rather than all 148 CSS colors; an
// unrecognised name leaves the property alone, which is the correct behaviour
// for an invalid declaration (CSS Cascade §4.1) and keeps the failure visible
// rather than painting something wrong.
module engine.style.values;

import engine.css.tokens as css_tokens;
import engine.style.computed;

// The outcome of parsing a value: `ok` is false when the tokens did not form
// something valid for that property, in which case the declaration is dropped.
struct StyleLengthResult {
    ok: bool,
    length: StyleLength,
}

struct StyleColorResult {
    ok: bool,
    color: StyleColor,
}

struct StyleKeywordResult {
    ok: bool,
    value: u8,
}

struct StyleNumberResult {
    ok: bool,
    value: f64,
}

fn ascii_lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' {
        return c + 32 as u8;
    }
    return c;
}

pub fn equals_ci(view: []const u8, text: *u8) -> bool {
    let length: u64 = 0;
    while text[length] != 0 as u8 {
        length = length + 1;
    }
    if len(view) != length {
        return false;
    }
    for index: u64 in 0..length {
        if ascii_lower(view[index]) != text[index] {
            return false;
        }
    }
    return true;
}

// The index of the first non-whitespace token at or after `from`, or `limit`.
pub fn skip_ws(s: *CssTokenSink, from: u64, limit: u64) -> u64 {
    let index: u64 = from;
    while index < limit
        && css_tokens.get_token(s, index).kind == css_tokens.kind_whitespace() {
        index = index + 1;
    }
    return index;
}

// --- Lengths -----------------------------------------------------------------

// Convert a dimension to pixels. `font_size` and `root_font_size` resolve the
// font-relative units. Returns ok=false for units rigor does not handle.
fn unit_to_px(
    value: f64,
    unit: []const u8,
    font_size: f64,
    root_font_size: f64
) -> StyleNumberResult {
    if equals_ci(unit, "px") {
        return StyleNumberResult { ok: true, value: value };
    }
    if equals_ci(unit, "em") {
        return StyleNumberResult { ok: true, value: value * font_size };
    }
    if equals_ci(unit, "rem") {
        return StyleNumberResult { ok: true, value: value * root_font_size };
    }
    // The absolute units, all defined against 96dpi (CSS Values §6.2).
    if equals_ci(unit, "pt") {
        return StyleNumberResult { ok: true, value: value * 96.0 / 72.0 };
    }
    if equals_ci(unit, "pc") {
        return StyleNumberResult { ok: true, value: value * 16.0 };
    }
    if equals_ci(unit, "in") {
        return StyleNumberResult { ok: true, value: value * 96.0 };
    }
    if equals_ci(unit, "cm") {
        return StyleNumberResult { ok: true, value: value * 96.0 / 2.54 };
    }
    if equals_ci(unit, "mm") {
        return StyleNumberResult { ok: true, value: value * 96.0 / 25.4 };
    }
    if equals_ci(unit, "q") {
        return StyleNumberResult { ok: true, value: value * 96.0 / 101.6 };
    }
    // ex and ch need font metrics rigor does not have yet; approximating them
    // silently would be worse than declining the declaration.
    return StyleNumberResult { ok: false, value: 0.0 };
}

// Parse a single length token: a dimension, a percentage, `auto`, or a bare 0.
pub fn parse_length(
    s: *CssTokenSink,
    index: u64,
    font_size: f64,
    root_font_size: f64,
    allow_auto: bool
) -> StyleLengthResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind == css_tokens.kind_dimension() {
        let converted: StyleNumberResult = unit_to_px(
            token.number, css_tokens.token_value(s, token),
            font_size, root_font_size);
        if !converted.ok {
            return StyleLengthResult { ok: false, length: computed.zero_length() };
        }
        return StyleLengthResult {
            ok: true, length: computed.px(converted.value),
        };
    }
    if token.kind == css_tokens.kind_percentage() {
        return StyleLengthResult {
            ok: true, length: computed.percent(token.number),
        };
    }
    if token.kind == css_tokens.kind_number() {
        // Only zero may be written without a unit.
        if token.number == 0.0 {
            return StyleLengthResult { ok: true, length: computed.zero_length() };
        }
        return StyleLengthResult { ok: false, length: computed.zero_length() };
    }
    if token.kind == css_tokens.kind_ident() && allow_auto {
        if equals_ci(css_tokens.token_value(s, token), "auto") {
            return StyleLengthResult { ok: true, length: computed.auto_length() };
        }
    }
    return StyleLengthResult { ok: false, length: computed.zero_length() };
}

// --- Colors ------------------------------------------------------------------

fn hex_digit(c: u8) -> i64 {
    if c >= '0' && c <= '9' { return (c - '0') as i64; }
    if c >= 'a' && c <= 'f' { return (c - 'a') as i64 + 10; }
    if c >= 'A' && c <= 'F' { return (c - 'A') as i64 + 10; }
    return -1;
}

fn parse_hex_color(digits: []const u8) -> StyleColorResult {
    let count: u64 = len(digits);
    if count != 3 && count != 4 && count != 6 && count != 8 {
        return StyleColorResult { ok: false, color: computed.black() };
    }
    for index: u64 in 0..count {
        if hex_digit(digits[index]) < 0 {
            return StyleColorResult { ok: false, color: computed.black() };
        }
    }
    if count == 3 || count == 4 {
        // Each digit is doubled: #abc is #aabbcc.
        let r: i64 = hex_digit(digits[0]);
        let g: i64 = hex_digit(digits[1]);
        let b: i64 = hex_digit(digits[2]);
        let a: i64 = 15;
        if count == 4 {
            a = hex_digit(digits[3]);
        }
        return StyleColorResult {
            ok: true,
            color: computed.rgba(
                ((r * 16) + r) as u8, ((g * 16) + g) as u8,
                ((b * 16) + b) as u8, ((a * 16) + a) as u8),
        };
    }
    let r: i64 = hex_digit(digits[0]) * 16 + hex_digit(digits[1]);
    let g: i64 = hex_digit(digits[2]) * 16 + hex_digit(digits[3]);
    let b: i64 = hex_digit(digits[4]) * 16 + hex_digit(digits[5]);
    let a: i64 = 255;
    if count == 8 {
        a = hex_digit(digits[6]) * 16 + hex_digit(digits[7]);
    }
    return StyleColorResult {
        ok: true,
        color: computed.rgba(r as u8, g as u8, b as u8, a as u8),
    };
}

fn named_color(name: []const u8) -> StyleColorResult {
    if equals_ci(name, "transparent") {
        return StyleColorResult { ok: true, color: computed.transparent() };
    }
    if equals_ci(name, "black") { return solid(0, 0, 0); }
    if equals_ci(name, "silver") { return solid(192, 192, 192); }
    if equals_ci(name, "gray") { return solid(128, 128, 128); }
    if equals_ci(name, "grey") { return solid(128, 128, 128); }
    if equals_ci(name, "white") { return solid(255, 255, 255); }
    if equals_ci(name, "maroon") { return solid(128, 0, 0); }
    if equals_ci(name, "red") { return solid(255, 0, 0); }
    if equals_ci(name, "purple") { return solid(128, 0, 128); }
    if equals_ci(name, "fuchsia") { return solid(255, 0, 255); }
    if equals_ci(name, "magenta") { return solid(255, 0, 255); }
    if equals_ci(name, "green") { return solid(0, 128, 0); }
    if equals_ci(name, "lime") { return solid(0, 255, 0); }
    if equals_ci(name, "olive") { return solid(128, 128, 0); }
    if equals_ci(name, "yellow") { return solid(255, 255, 0); }
    if equals_ci(name, "navy") { return solid(0, 0, 128); }
    if equals_ci(name, "blue") { return solid(0, 0, 255); }
    if equals_ci(name, "teal") { return solid(0, 128, 128); }
    if equals_ci(name, "aqua") { return solid(0, 255, 255); }
    if equals_ci(name, "cyan") { return solid(0, 255, 255); }
    if equals_ci(name, "orange") { return solid(255, 165, 0); }
    if equals_ci(name, "pink") { return solid(255, 192, 203); }
    if equals_ci(name, "brown") { return solid(165, 42, 42); }
    if equals_ci(name, "gold") { return solid(255, 215, 0); }
    if equals_ci(name, "indigo") { return solid(75, 0, 130); }
    if equals_ci(name, "violet") { return solid(238, 130, 238); }
    if equals_ci(name, "beige") { return solid(245, 245, 220); }
    if equals_ci(name, "ivory") { return solid(255, 255, 240); }
    if equals_ci(name, "khaki") { return solid(240, 230, 140); }
    if equals_ci(name, "salmon") { return solid(250, 128, 114); }
    if equals_ci(name, "tan") { return solid(210, 180, 140); }
    if equals_ci(name, "turquoise") { return solid(64, 224, 208); }
    if equals_ci(name, "crimson") { return solid(220, 20, 60); }
    if equals_ci(name, "coral") { return solid(255, 127, 80); }
    if equals_ci(name, "lavender") { return solid(230, 230, 250); }
    if equals_ci(name, "plum") { return solid(221, 160, 221); }
    if equals_ci(name, "orchid") { return solid(218, 112, 214); }
    if equals_ci(name, "wheat") { return solid(245, 222, 179); }
    if equals_ci(name, "whitesmoke") { return solid(245, 245, 245); }
    if equals_ci(name, "gainsboro") { return solid(220, 220, 220); }
    if equals_ci(name, "lightgray") { return solid(211, 211, 211); }
    if equals_ci(name, "lightgrey") { return solid(211, 211, 211); }
    if equals_ci(name, "darkgray") { return solid(169, 169, 169); }
    if equals_ci(name, "darkgrey") { return solid(169, 169, 169); }
    if equals_ci(name, "dimgray") { return solid(105, 105, 105); }
    if equals_ci(name, "lightblue") { return solid(173, 216, 230); }
    if equals_ci(name, "skyblue") { return solid(135, 206, 235); }
    if equals_ci(name, "steelblue") { return solid(70, 130, 180); }
    if equals_ci(name, "royalblue") { return solid(65, 105, 225); }
    if equals_ci(name, "midnightblue") { return solid(25, 25, 112); }
    if equals_ci(name, "lightgreen") { return solid(144, 238, 144); }
    if equals_ci(name, "darkgreen") { return solid(0, 100, 0); }
    if equals_ci(name, "seagreen") { return solid(46, 139, 87); }
    if equals_ci(name, "forestgreen") { return solid(34, 139, 34); }
    if equals_ci(name, "darkred") { return solid(139, 0, 0); }
    if equals_ci(name, "darkblue") { return solid(0, 0, 139); }
    if equals_ci(name, "goldenrod") { return solid(218, 165, 32); }
    if equals_ci(name, "chocolate") { return solid(210, 105, 30); }
    if equals_ci(name, "sienna") { return solid(160, 82, 45); }
    if equals_ci(name, "tomato") { return solid(255, 99, 71); }
    return StyleColorResult { ok: false, color: computed.black() };
}

fn solid(r: i64, g: i64, b: i64) -> StyleColorResult {
    return StyleColorResult {
        ok: true,
        color: computed.rgba(r as u8, g as u8, b as u8, 255 as u8),
    };
}

fn clamp_channel(value: f64) -> u8 {
    if value <= 0.0 {
        return 0 as u8;
    }
    if value >= 255.0 {
        return 255 as u8;
    }
    return (value + 0.5) as u8;
}

// Parse a colour starting at `index`, which may span several tokens when it is
// an rgb()/rgba() function.
pub fn parse_color(
    s: *CssTokenSink,
    index: u64,
    limit: u64
) -> StyleColorResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind == css_tokens.kind_hash() {
        return parse_hex_color(css_tokens.token_value(s, token));
    }
    if token.kind == css_tokens.kind_ident() {
        return named_color(css_tokens.token_value(s, token));
    }
    if token.kind == css_tokens.kind_function() {
        let name: []const u8 = css_tokens.token_value(s, token);
        if !equals_ci(name, "rgb") && !equals_ci(name, "rgba") {
            return StyleColorResult { ok: false, color: computed.black() };
        }
        // Read up to four numeric arguments, ignoring commas, slashes and
        // whitespace — which covers both the legacy and modern syntaxes.
        let channels: [f64; 4] = [0.0, 0.0, 0.0, 1.0];
        let found: u64 = 0;
        let cursor: u64 = index + 1;
        while cursor < limit && found < 4 {
            let argument: CssToken = css_tokens.get_token(s, cursor);
            if argument.kind == css_tokens.kind_close_paren() {
                break;
            }
            if argument.kind == css_tokens.kind_number() {
                channels[found] = argument.number;
                found = found + 1;
            } else if argument.kind == css_tokens.kind_percentage() {
                if found < 3 {
                    channels[found] = argument.number * 255.0 / 100.0;
                } else {
                    channels[found] = argument.number / 100.0;
                }
                found = found + 1;
            }
            cursor = cursor + 1;
        }
        if found < 3 {
            return StyleColorResult { ok: false, color: computed.black() };
        }
        let alpha: f64 = channels[3];
        if alpha < 0.0 { alpha = 0.0; }
        if alpha > 1.0 { alpha = 1.0; }
        return StyleColorResult {
            ok: true,
            color: computed.rgba(
                clamp_channel(channels[0]),
                clamp_channel(channels[1]),
                clamp_channel(channels[2]),
                clamp_channel(alpha * 255.0)),
        };
    }
    return StyleColorResult { ok: false, color: computed.black() };
}

// --- Keywords ----------------------------------------------------------------

pub fn parse_display(s: *CssTokenSink, index: u64) -> StyleKeywordResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind != css_tokens.kind_ident() {
        return StyleKeywordResult { ok: false, value: 0 as u8 };
    }
    let name: []const u8 = css_tokens.token_value(s, token);
    if equals_ci(name, "block") {
        return StyleKeywordResult { ok: true, value: computed.display_block() };
    }
    if equals_ci(name, "inline") {
        return StyleKeywordResult { ok: true, value: computed.display_inline() };
    }
    if equals_ci(name, "inline-block") {
        return StyleKeywordResult {
            ok: true, value: computed.display_inline_block(),
        };
    }
    if equals_ci(name, "list-item") {
        return StyleKeywordResult { ok: true, value: computed.display_list_item() };
    }
    if equals_ci(name, "none") {
        return StyleKeywordResult { ok: true, value: computed.display_none() };
    }
    if equals_ci(name, "table") {
        return StyleKeywordResult { ok: true, value: computed.display_table() };
    }
    if equals_ci(name, "table-row") {
        return StyleKeywordResult { ok: true, value: computed.display_table_row() };
    }
    if equals_ci(name, "table-cell") {
        return StyleKeywordResult { ok: true, value: computed.display_table_cell() };
    }
    if equals_ci(name, "table-row-group") || equals_ci(name, "table-header-group")
        || equals_ci(name, "table-footer-group") {
        return StyleKeywordResult {
            ok: true, value: computed.display_table_row_group(),
        };
    }
    return StyleKeywordResult { ok: false, value: 0 as u8 };
}

pub fn parse_text_align(s: *CssTokenSink, index: u64) -> StyleKeywordResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind != css_tokens.kind_ident() {
        return StyleKeywordResult { ok: false, value: 0 as u8 };
    }
    let name: []const u8 = css_tokens.token_value(s, token);
    if equals_ci(name, "left") || equals_ci(name, "start") {
        return StyleKeywordResult { ok: true, value: computed.text_align_left() };
    }
    if equals_ci(name, "right") || equals_ci(name, "end") {
        return StyleKeywordResult { ok: true, value: computed.text_align_right() };
    }
    if equals_ci(name, "center") {
        return StyleKeywordResult { ok: true, value: computed.text_align_center() };
    }
    if equals_ci(name, "justify") {
        return StyleKeywordResult { ok: true, value: computed.text_align_justify() };
    }
    return StyleKeywordResult { ok: false, value: 0 as u8 };
}

pub fn parse_white_space(s: *CssTokenSink, index: u64) -> StyleKeywordResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind != css_tokens.kind_ident() {
        return StyleKeywordResult { ok: false, value: 0 as u8 };
    }
    let name: []const u8 = css_tokens.token_value(s, token);
    if equals_ci(name, "normal") {
        return StyleKeywordResult { ok: true, value: computed.white_space_normal() };
    }
    if equals_ci(name, "pre") || equals_ci(name, "pre-wrap") {
        return StyleKeywordResult { ok: true, value: computed.white_space_pre() };
    }
    if equals_ci(name, "nowrap") {
        return StyleKeywordResult { ok: true, value: computed.white_space_nowrap() };
    }
    return StyleKeywordResult { ok: false, value: 0 as u8 };
}

pub fn parse_font_style(s: *CssTokenSink, index: u64) -> StyleKeywordResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind != css_tokens.kind_ident() {
        return StyleKeywordResult { ok: false, value: 0 as u8 };
    }
    let name: []const u8 = css_tokens.token_value(s, token);
    if equals_ci(name, "normal") {
        return StyleKeywordResult { ok: true, value: computed.font_style_normal() };
    }
    if equals_ci(name, "italic") || equals_ci(name, "oblique") {
        return StyleKeywordResult { ok: true, value: computed.font_style_italic() };
    }
    return StyleKeywordResult { ok: false, value: 0 as u8 };
}

pub fn parse_border_style(s: *CssTokenSink, index: u64) -> StyleKeywordResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind != css_tokens.kind_ident() {
        return StyleKeywordResult { ok: false, value: 0 as u8 };
    }
    let name: []const u8 = css_tokens.token_value(s, token);
    if equals_ci(name, "none") || equals_ci(name, "hidden") {
        return StyleKeywordResult { ok: true, value: computed.border_none() };
    }
    if equals_ci(name, "solid") {
        return StyleKeywordResult { ok: true, value: computed.border_solid() };
    }
    if equals_ci(name, "dashed") {
        return StyleKeywordResult { ok: true, value: computed.border_dashed() };
    }
    if equals_ci(name, "dotted") {
        return StyleKeywordResult { ok: true, value: computed.border_dotted() };
    }
    if equals_ci(name, "double") || equals_ci(name, "groove")
        || equals_ci(name, "ridge") || equals_ci(name, "inset")
        || equals_ci(name, "outset") {
        return StyleKeywordResult { ok: true, value: computed.border_double() };
    }
    return StyleKeywordResult { ok: false, value: 0 as u8 };
}

// font-weight: the keywords plus the numeric scale.
pub fn parse_font_weight(s: *CssTokenSink, index: u64) -> StyleNumberResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind == css_tokens.kind_number() {
        if token.number >= 1.0 && token.number <= 1000.0 {
            return StyleNumberResult { ok: true, value: token.number };
        }
        return StyleNumberResult { ok: false, value: 0.0 };
    }
    if token.kind != css_tokens.kind_ident() {
        return StyleNumberResult { ok: false, value: 0.0 };
    }
    let name: []const u8 = css_tokens.token_value(s, token);
    if equals_ci(name, "normal") {
        return StyleNumberResult { ok: true, value: 400.0 };
    }
    if equals_ci(name, "bold") {
        return StyleNumberResult { ok: true, value: 700.0 };
    }
    // bolder/lighter are relative to the parent; without that context here
    // they resolve to the nearest absolute step, which is what the spec's
    // table does for the common cases.
    if equals_ci(name, "bolder") {
        return StyleNumberResult { ok: true, value: 700.0 };
    }
    if equals_ci(name, "lighter") {
        return StyleNumberResult { ok: true, value: 100.0 };
    }
    return StyleNumberResult { ok: false, value: 0.0 };
}

// font-size: lengths, percentages of the parent size, and the absolute
// keywords (CSS Fonts §3.5), which are defined relative to a 16px medium.
pub fn parse_font_size(
    s: *CssTokenSink,
    index: u64,
    parent_size: f64,
    root_size: f64
) -> StyleNumberResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind == css_tokens.kind_ident() {
        let name: []const u8 = css_tokens.token_value(s, token);
        if equals_ci(name, "xx-small") { return ok_number(9.0); }
        if equals_ci(name, "x-small") { return ok_number(10.0); }
        if equals_ci(name, "small") { return ok_number(13.0); }
        if equals_ci(name, "medium") { return ok_number(16.0); }
        if equals_ci(name, "large") { return ok_number(18.0); }
        if equals_ci(name, "x-large") { return ok_number(24.0); }
        if equals_ci(name, "xx-large") { return ok_number(32.0); }
        if equals_ci(name, "smaller") { return ok_number(parent_size / 1.2); }
        if equals_ci(name, "larger") { return ok_number(parent_size * 1.2); }
        return StyleNumberResult { ok: false, value: 0.0 };
    }
    if token.kind == css_tokens.kind_percentage() {
        return ok_number(parent_size * token.number / 100.0);
    }
    // em in a font-size resolves against the *parent's* size, not the
    // element's own — the element's is what is being computed.
    let length: StyleLengthResult =
        parse_length(s, index, parent_size, root_size, false);
    if !length.ok || length.length.kind != computed.length_px() {
        return StyleNumberResult { ok: false, value: 0.0 };
    }
    return ok_number(length.length.value);
}

fn ok_number(value: f64) -> StyleNumberResult {
    return StyleNumberResult { ok: true, value: value };
}

// line-height: `normal`, a unitless multiplier, a length, or a percentage.
pub fn parse_line_height(
    s: *CssTokenSink,
    index: u64,
    font_size: f64,
    root_size: f64
) -> StyleNumberResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind == css_tokens.kind_ident() {
        if equals_ci(css_tokens.token_value(s, token), "normal") {
            return ok_number(font_size * 1.2);
        }
        return StyleNumberResult { ok: false, value: 0.0 };
    }
    if token.kind == css_tokens.kind_number() {
        return ok_number(font_size * token.number);
    }
    if token.kind == css_tokens.kind_percentage() {
        return ok_number(font_size * token.number / 100.0);
    }
    let length: StyleLengthResult =
        parse_length(s, index, font_size, root_size, false);
    if !length.ok || length.length.kind != computed.length_px() {
        return StyleNumberResult { ok: false, value: 0.0 };
    }
    return ok_number(length.length.value);
}

// border-width: the three keywords plus any length.
pub fn parse_border_width(
    s: *CssTokenSink,
    index: u64,
    font_size: f64,
    root_size: f64
) -> StyleNumberResult {
    let token: CssToken = css_tokens.get_token(s, index);
    if token.kind == css_tokens.kind_ident() {
        let name: []const u8 = css_tokens.token_value(s, token);
        if equals_ci(name, "thin") { return ok_number(1.0); }
        if equals_ci(name, "medium") { return ok_number(3.0); }
        if equals_ci(name, "thick") { return ok_number(5.0); }
        return StyleNumberResult { ok: false, value: 0.0 };
    }
    let length: StyleLengthResult =
        parse_length(s, index, font_size, root_size, false);
    if !length.ok || length.length.kind != computed.length_px() {
        return StyleNumberResult { ok: false, value: 0.0 };
    }
    return ok_number(length.length.value);
}
