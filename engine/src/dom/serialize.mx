// Serialize a DOM tree in the html5lib-tests tree-construction format.
//
// That format is the lingua franca for comparing parser output:
//
//     | <html>
//     |   <head>
//     |   <body>
//     |     <p>
//     |       class="intro"
//     |       "hello"
//
// Each line begins with "| ", then two spaces per level of depth. Elements
// appear as <name>, attributes as name="value" (sorted, one level deeper than
// their element), text as "data", comments as <!-- data -->, and doctypes as
// <!DOCTYPE name> — with quoted public and system identifiers when present.
//
// Producing exactly this shape means rigor's tree output can be diffed
// directly against the suites, and it doubles as a readable debug dump.
module engine.dom.serialize;

import std.vec;
import engine.dom.node;

fn push_str(out: *Vec<u8>, text: *u8) -> void {
    let index: u64 = 0;
    while text[index] != 0 as u8 {
        vec.push(out, text[index]);
        index = index + 1;
    }
}

fn push_view(out: *Vec<u8>, view: []const u8) -> void {
    for index: u64 in 0..len(view) {
        vec.push(out, view[index]);
    }
}

fn push_indent(out: *Vec<u8>, depth: u64) -> void {
    push_str(out, "| ");
    for step: u64 in 0..depth {
        push_str(out, "  ");
    }
}

fn compare_views(left: []const u8, right: []const u8) -> i64 {
    let shared: u64 = len(left);
    if len(right) < shared {
        shared = len(right);
    }
    for index: u64 in 0..shared {
        if left[index] < right[index] {
            return -1;
        }
        if left[index] > right[index] {
            return 1;
        }
    }
    if len(left) < len(right) {
        return -1;
    }
    if len(left) > len(right) {
        return 1;
    }
    return 0;
}

// Attributes print in alphabetical order regardless of source order, which is
// what the suites expect. Duplicate attribute names are dropped during
// tokenization, so every name on an element is unique and "the smallest name
// greater than the last one printed" is a well-defined next entry.
fn write_attributes(
    out: *Vec<u8>,
    doc: *DomDocument,
    element: u64,
    depth: u64
) -> void {
    let n: DomNode = node.get(doc, element);
    let printed: u64 = 0;
    let has_previous: bool = false;
    let previous_off: u64 = 0;
    let previous_len: u64 = 0;
    while printed < n.attr_count {
        let best: u64 = n.attr_count;
        for index: u64 in 0..n.attr_count {
            let candidate: DomAttr = node.get_attr(doc, n.attr_first + index);
            let name: []const u8 =
                node.bytes(doc, candidate.name_off, candidate.name_len);
            let after_previous: bool = true;
            if has_previous {
                after_previous = compare_views(
                    node.bytes(doc, previous_off, previous_len), name) < 0;
            }
            if after_previous {
                if best == n.attr_count {
                    best = index;
                } else {
                    let current: DomAttr = node.get_attr(doc, n.attr_first + best);
                    if compare_views(name,
                        node.bytes(doc, current.name_off, current.name_len)) < 0 {
                        best = index;
                    }
                }
            }
        }
        if best == n.attr_count {
            return;
        }
        let attr: DomAttr = node.get_attr(doc, n.attr_first + best);
        push_indent(out, depth);
        // A namespaced attribute prints as "prefix local".
        if attr.prefix_len > 0 {
            push_view(out, node.bytes(doc, attr.prefix_off, attr.prefix_len));
            push_str(out, " ");
        }
        push_view(out, node.bytes(doc, attr.name_off, attr.name_len));
        push_str(out, "=\"");
        push_view(out, node.bytes(doc, attr.value_off, attr.value_len));
        push_str(out, "\"\n");
        previous_off = attr.name_off;
        previous_len = attr.name_len;
        has_previous = true;
        printed = printed + 1;
    }
}

fn write_node(out: *Vec<u8>, doc: *DomDocument, index: u64, depth: u64) -> void {
    let n: DomNode = node.get(doc, index);
    if n.kind == node.kind_element() {
        push_indent(out, depth);
        push_str(out, "<");
        if n.namespace == node.ns_svg() {
            push_str(out, "svg ");
        } else if n.namespace == node.ns_mathml() {
            push_str(out, "math ");
        }
        push_view(out, node.bytes(doc, n.name_off, n.name_len));
        push_str(out, ">\n");
        write_attributes(out, doc, index, depth + 1);
    } else if n.kind == node.kind_text() {
        push_indent(out, depth);
        push_str(out, "\"");
        push_view(out, node.bytes(doc, n.data_off, n.data_len));
        push_str(out, "\"\n");
    } else if n.kind == node.kind_comment() {
        push_indent(out, depth);
        push_str(out, "<!-- ");
        push_view(out, node.bytes(doc, n.data_off, n.data_len));
        push_str(out, " -->\n");
    } else if n.kind == node.kind_doctype() {
        push_indent(out, depth);
        push_str(out, "<!DOCTYPE ");
        push_view(out, node.bytes(doc, n.name_off, n.name_len));
        if n.has_public || n.has_system {
            push_str(out, " \"");
            push_view(out, node.bytes(doc, n.data_off, n.data_len));
            push_str(out, "\" \"");
            push_view(out, node.bytes(doc, n.extra_off, n.extra_len));
            push_str(out, "\"");
        }
        push_str(out, ">\n");
    }
    let child: u64 = n.first_child;
    while child != node.none() {
        write_node(out, doc, child, depth + 1);
        let child_node: DomNode = node.get(doc, child);
        child = child_node.next_sibling;
    }
}

// Serialize the whole document into a fresh owned buffer, which the caller
// must eventually vec.destroy.
pub fn document(doc: *DomDocument) -> Vec<u8> {
    let out: Vec<u8> = vec.new<u8>();
    let root: DomNode = node.get(doc, 0);
    let child: u64 = root.first_child;
    while child != node.none() {
        write_node(&out, doc, child, 0);
        let child_node: DomNode = node.get(doc, child);
        child = child_node.next_sibling;
    }
    return move out;
}
