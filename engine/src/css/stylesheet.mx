// The parsed stylesheet, as a flat arena.
//
// Rules, selectors, and declarations are plain-data records in parallel Vecs,
// with every name and string in a shared byte pool. A stylesheet is
// self-contained: names are copied out of the token sink rather than
// referenced, so the sink can be dropped and several stylesheets from
// different origins can be cascaded together.
//
// Declaration *values* are the exception: they stay as a token range into the
// sink that produced them, because property parsing happens later (and lazily,
// per property) and copying every value token would be wasted work for the
// declarations that lose the cascade.
module engine.css.stylesheet;

import std.vec;

// Rule kinds.
pub fn rule_style() -> u8 { return 0 as u8; }
pub fn rule_at() -> u8 { return 1 as u8; }

// Simple selector kinds (Selectors Level 4 §3).
pub fn simple_type() -> u8 { return 0 as u8; }
pub fn simple_universal() -> u8 { return 1 as u8; }
pub fn simple_class() -> u8 { return 2 as u8; }
pub fn simple_id() -> u8 { return 3 as u8; }
pub fn simple_attribute() -> u8 { return 4 as u8; }
pub fn simple_pseudo_class() -> u8 { return 5 as u8; }
pub fn simple_pseudo_element() -> u8 { return 6 as u8; }

// Attribute matchers (§6).
pub fn match_exists() -> u8 { return 0 as u8; }
pub fn match_equals() -> u8 { return 1 as u8; }
pub fn match_includes() -> u8 { return 2 as u8; }      // ~=
pub fn match_dash() -> u8 { return 3 as u8; }          // |=
pub fn match_prefix() -> u8 { return 4 as u8; }        // ^=
pub fn match_suffix() -> u8 { return 5 as u8; }        // $=
pub fn match_substring() -> u8 { return 6 as u8; }     // *=

// Combinators, recorded on the compound that follows them (§14).
pub fn combinator_none() -> u8 { return 0 as u8; }
pub fn combinator_descendant() -> u8 { return 1 as u8; }
pub fn combinator_child() -> u8 { return 2 as u8; }
pub fn combinator_next_sibling() -> u8 { return 3 as u8; }
pub fn combinator_subsequent_sibling() -> u8 { return 4 as u8; }

struct CssSimpleSelector {
    kind: u8,
    matcher: u8,
    // Type/class/id/attribute/pseudo name.
    name_off: u64,
    name_len: u64,
    // Attribute selector's expected value.
    value_off: u64,
    value_len: u64,
    // Attribute selectors written with the ASCII case-insensitive flag, as in
    // [type="text" i].
    case_insensitive: bool,
}

// A compound selector: simple selectors that must all match one element,
// preceded by the combinator that links it to the previous compound.
struct CssCompound {
    simple_first: u64,
    simple_count: u64,
    combinator: u8,
}

// A complex selector: compounds joined by combinators, read left to right.
struct CssSelector {
    compound_first: u64,
    compound_count: u64,
    specificity: u32,
    valid: bool,
}

struct CssDeclaration {
    name_off: u64,
    name_len: u64,
    // Range of tokens in the originating CssTokenSink holding the value.
    value_first: u64,
    value_count: u64,
    important: bool,
}

struct CssRule {
    kind: u8,
    // At-rule name, without the '@'.
    name_off: u64,
    name_len: u64,
    // Style rules: their selector list.
    selector_first: u64,
    selector_count: u64,
    // Declarations in the rule's block.
    decl_first: u64,
    decl_count: u64,
    // At-rules whose block holds rules rather than declarations, e.g. @media.
    child_first: u64,
    child_count: u64,
    // At-rule prelude, as a token range in the originating sink.
    prelude_first: u64,
    prelude_count: u64,
    has_block: bool,
}

resource struct CssStylesheet {
    rules: Vec<CssRule>,
    selectors: Vec<CssSelector>,
    compounds: Vec<CssCompound>,
    simples: Vec<CssSimpleSelector>,
    declarations: Vec<CssDeclaration>,
    pool: Vec<u8>,
    // Indices into `rules` of the sheet's own top-level rules. Nested rules
    // live in the same Vec but are reached through their parent.
    top_level: Vec<u64>,
}

pub fn new_stylesheet() -> CssStylesheet {
    return CssStylesheet {
        rules: vec.new<CssRule>(),
        selectors: vec.new<CssSelector>(),
        compounds: vec.new<CssCompound>(),
        simples: vec.new<CssSimpleSelector>(),
        declarations: vec.new<CssDeclaration>(),
        pool: vec.new<u8>(),
        top_level: vec.new<u64>(),
    };
}

pub fn destroy(sheet: *CssStylesheet) -> void {
    vec.destroy(&(*sheet).rules);
    vec.destroy(&(*sheet).selectors);
    vec.destroy(&(*sheet).compounds);
    vec.destroy(&(*sheet).simples);
    vec.destroy(&(*sheet).declarations);
    vec.destroy(&(*sheet).pool);
    vec.destroy(&(*sheet).top_level);
}

pub fn bytes(sheet: *CssStylesheet, offset: u64, length: u64) -> []const u8 {
    let base: *const u8 = (*sheet).pool.data as *const u8;
    return slice((&base[offset]) as *const u8, length);
}

// Copy `view` into the sheet's pool and return its offset.
pub fn intern(sheet: *CssStylesheet, view: []const u8) -> u64 {
    let offset: u64 = (*sheet).pool.length;
    for index: u64 in 0..len(view) {
        vec.push(&(*sheet).pool, view[index]);
    }
    return offset;
}

// --- Accessors ---------------------------------------------------------------

pub fn rule_count(sheet: *CssStylesheet) -> u64 {
    return (*sheet).top_level.length;
}

pub fn top_level_rule(sheet: *CssStylesheet, index: u64) -> u64 {
    match vec.get(&(*sheet).top_level, index) {
        Option<u64>.Some(value) => { return value; },
        Option<u64>.None => { return 0; },
    }
}

pub fn get_rule(sheet: *CssStylesheet, index: u64) -> CssRule {
    match vec.get(&(*sheet).rules, index) {
        Option<CssRule>.Some(rule) => { return rule; },
        Option<CssRule>.None => { return empty_rule(); },
    }
}

pub fn empty_rule() -> CssRule {
    return CssRule {
        kind: 0 as u8,
        name_off: 0, name_len: 0,
        selector_first: 0, selector_count: 0,
        decl_first: 0, decl_count: 0,
        child_first: 0, child_count: 0,
        prelude_first: 0, prelude_count: 0,
        has_block: false,
    };
}

pub fn get_selector(sheet: *CssStylesheet, index: u64) -> CssSelector {
    match vec.get(&(*sheet).selectors, index) {
        Option<CssSelector>.Some(selector) => { return selector; },
        Option<CssSelector>.None => {
            return CssSelector {
                compound_first: 0, compound_count: 0,
                specificity: 0 as u32, valid: false,
            };
        },
    }
}

pub fn get_compound(sheet: *CssStylesheet, index: u64) -> CssCompound {
    match vec.get(&(*sheet).compounds, index) {
        Option<CssCompound>.Some(compound) => { return compound; },
        Option<CssCompound>.None => {
            return CssCompound {
                simple_first: 0, simple_count: 0, combinator: 0 as u8,
            };
        },
    }
}

pub fn get_simple(sheet: *CssStylesheet, index: u64) -> CssSimpleSelector {
    match vec.get(&(*sheet).simples, index) {
        Option<CssSimpleSelector>.Some(simple) => { return simple; },
        Option<CssSimpleSelector>.None => { return empty_simple(); },
    }
}

pub fn empty_simple() -> CssSimpleSelector {
    return CssSimpleSelector {
        kind: 0 as u8,
        matcher: 0 as u8,
        name_off: 0, name_len: 0,
        value_off: 0, value_len: 0,
        case_insensitive: false,
    };
}

pub fn get_declaration(sheet: *CssStylesheet, index: u64) -> CssDeclaration {
    match vec.get(&(*sheet).declarations, index) {
        Option<CssDeclaration>.Some(declaration) => { return declaration; },
        Option<CssDeclaration>.None => {
            return CssDeclaration {
                name_off: 0, name_len: 0,
                value_first: 0, value_count: 0,
                important: false,
            };
        },
    }
}

// --- Specificity -------------------------------------------------------------
//
// Selectors Level 4 §16: specificity is the triple (A, B, C) — id selectors,
// then class/attribute/pseudo-class selectors, then type/pseudo-element
// selectors. Packing it into one u32 as A<<20 | B<<10 | C keeps comparison a
// single integer compare. Each field saturates at 1023, which no real
// selector approaches.

pub fn pack_specificity(a: u32, b: u32, c: u32) -> u32 {
    let ids: u32 = a;
    let classes: u32 = b;
    let types: u32 = c;
    if ids > 1023 as u32 { ids = 1023 as u32; }
    if classes > 1023 as u32 { classes = 1023 as u32; }
    if types > 1023 as u32 { types = 1023 as u32; }
    return (ids << 20) | (classes << 10) | types;
}

pub fn specificity_ids(packed: u32) -> u32 { return packed >> 20; }
pub fn specificity_classes(packed: u32) -> u32 {
    return (packed >> 10) & (1023 as u32);
}
pub fn specificity_types(packed: u32) -> u32 { return packed & (1023 as u32); }
