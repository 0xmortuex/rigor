// The CSS tokenizer — CSS Syntax Module Level 3 §4.3.
//
// Each function here is one of the spec's "consume" algorithms, cited by
// section number. The input must already have been through
// engine.css.preprocess, so no CR, FF, NUL or surrogate ever reaches this
// code and the algorithms match the spec text line for line.
//
// Byte-encoding note: like the HTML tokenizer, this works on UTF-8 bytes
// directly. Every code point the state machine branches on is ASCII, and the
// spec's "non-ASCII ident code point" class is exactly "code point >= U+0080"
// — which in UTF-8 is exactly "byte >= 0x80", including every continuation
// byte. So multi-byte sequences flow through identifiers and strings intact
// without a decoding pass.
module engine.css.tokenizer;

import std.vec;
import tokens;

struct CssTokenizer {
    input: *const u8,
    length: u64,
    pos: u64,
}

pub fn new(input: *const u8, length: u64) -> CssTokenizer {
    return CssTokenizer { input: input, length: length, pos: 0 };
}

// --- Code point classes (§4.2 definitions) ----------------------------------

fn is_digit(c: u8) -> bool { return c >= '0' && c <= '9'; }

fn is_hex(c: u8) -> bool {
    return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

fn is_upper(c: u8) -> bool { return c >= 'A' && c <= 'Z'; }
fn is_lower(c: u8) -> bool { return c >= 'a' && c <= 'z'; }
fn is_letter(c: u8) -> bool { return is_upper(c) || is_lower(c); }

// "ident-start code point": a letter, a non-ASCII code point, or U+005F _.
fn is_ident_start(c: u8) -> bool {
    return is_letter(c) || c >= 0x80 as u8 || c == '_';
}

// "ident code point": an ident-start code point, a digit, or U+002D -.
fn is_ident(c: u8) -> bool {
    return is_ident_start(c) || is_digit(c) || c == '-';
}

// "whitespace": newline, tab, or space (CR and FF are gone by now).
fn is_ws(c: u8) -> bool {
    return c == 10 as u8 || c == 9 as u8 || c == 32 as u8;
}

// "non-printable code point", which makes a url token bad.
fn is_non_printable(c: u8) -> bool {
    return c <= 8 as u8 || c == 11 as u8
        || (c >= 14 as u8 && c <= 31 as u8) || c == 127 as u8;
}

// --- Input helpers -----------------------------------------------------------

fn at_eof(t: *CssTokenizer) -> bool {
    return (*t).pos >= (*t).length;
}

// The byte `offset` positions ahead, or 0 past the end. Since preprocessing
// removed every NUL, 0 unambiguously means "end of input".
fn peek(t: *CssTokenizer, offset: u64) -> u8 {
    if (*t).pos + offset >= (*t).length {
        return 0 as u8;
    }
    return (*t).input[(*t).pos + offset];
}

fn take(t: *CssTokenizer) -> u8 {
    let c: u8 = (*t).input[(*t).pos];
    (*t).pos = (*t).pos + 1;
    return c;
}

fn error(t: *CssTokenizer, s: *CssTokenSink, code: u32) -> void {
    vec.push(&(*s).errors, CssParseError { code: code, pos: (*t).pos });
}

fn pool_push(s: *CssTokenSink, b: u8) -> void {
    vec.push(&(*s).pool, b);
}

fn pool_push_cp(s: *CssTokenSink, cp: u32) -> void {
    if cp < 0x80 as u32 {
        pool_push(s, cp as u8);
    } else if cp < 0x800 as u32 {
        pool_push(s, ((0xC0 as u32) | (cp >> 6)) as u8);
        pool_push(s, ((0x80 as u32) | (cp & (0x3F as u32))) as u8);
    } else if cp < 0x10000 as u32 {
        pool_push(s, ((0xE0 as u32) | (cp >> 12)) as u8);
        pool_push(s, ((0x80 as u32) | ((cp >> 6) & (0x3F as u32))) as u8);
        pool_push(s, ((0x80 as u32) | (cp & (0x3F as u32))) as u8);
    } else {
        pool_push(s, ((0xF0 as u32) | (cp >> 18)) as u8);
        pool_push(s, ((0x80 as u32) | ((cp >> 12) & (0x3F as u32))) as u8);
        pool_push(s, ((0x80 as u32) | ((cp >> 6) & (0x3F as u32))) as u8);
        pool_push(s, ((0x80 as u32) | (cp & (0x3F as u32))) as u8);
    }
}

// --- §4.3.8 "check if two code points are a valid escape" -------------------

fn is_valid_escape_at(t: *CssTokenizer, offset: u64) -> bool {
    if peek(t, offset) != 92 as u8 {
        return false;
    }
    if (*t).pos + offset + 1 >= (*t).length {
        return false;
    }
    return peek(t, offset + 1) != 10 as u8;
}

// --- §4.3.9 "check if three code points would start an ident sequence" ------

fn would_start_ident(t: *CssTokenizer, offset: u64) -> bool {
    let first: u8 = peek(t, offset);
    if first == '-' {
        let second: u8 = peek(t, offset + 1);
        if is_ident_start(second) || second == '-' {
            return true;
        }
        return is_valid_escape_at(t, offset + 1);
    }
    if is_ident_start(first) {
        return true;
    }
    return is_valid_escape_at(t, offset);
}

// --- §4.3.10 "check if three code points would start a number" --------------

fn would_start_number(t: *CssTokenizer, offset: u64) -> bool {
    let first: u8 = peek(t, offset);
    if first == '+' || first == '-' {
        let second: u8 = peek(t, offset + 1);
        if is_digit(second) {
            return true;
        }
        return second == '.' && is_digit(peek(t, offset + 2));
    }
    if first == '.' {
        return is_digit(peek(t, offset + 1));
    }
    return is_digit(first);
}

// --- §4.3.7 "consume an escaped code point" ---------------------------------
// The leading backslash has already been consumed.
fn consume_escape(t: *CssTokenizer, s: *CssTokenSink) -> void {
    if at_eof(t) {
        // Parse error; the spec yields U+FFFD.
        error(t, s, tokens.err_invalid_escape());
        pool_push_cp(s, 0xFFFD as u32);
        return;
    }
    let c: u8 = take(t);
    if !is_hex(c) {
        pool_push(s, c);
        return;
    }
    let value: u32 = hex_value(c);
    let digits: u64 = 1;
    while digits < 6 && is_hex(peek(t, 0)) {
        value = value * (16 as u32) + hex_value(take(t));
        digits = digits + 1;
    }
    if is_ws(peek(t, 0)) {
        (*t).pos = (*t).pos + 1;
    }
    // A zero, surrogate or out-of-range escape becomes U+FFFD.
    if value == 0 as u32 || value > 0x10FFFF as u32
        || (value >= 0xD800 as u32 && value <= 0xDFFF as u32) {
        pool_push_cp(s, 0xFFFD as u32);
        return;
    }
    pool_push_cp(s, value);
}

fn hex_value(c: u8) -> u32 {
    if is_digit(c) {
        return (c - '0') as u32;
    }
    if c >= 'a' && c <= 'f' {
        return (c - 'a') as u32 + 10 as u32;
    }
    return (c - 'A') as u32 + 10 as u32;
}

// --- §4.3.11 "consume an ident sequence" ------------------------------------
// Appends to the pool and returns the byte length written.
fn consume_ident_sequence(t: *CssTokenizer, s: *CssTokenSink) -> u64 {
    let start: u64 = (*s).pool.length;
    loop {
        if at_eof(t) {
            break;
        }
        let c: u8 = peek(t, 0);
        if is_ident(c) {
            pool_push(s, take(t));
        } else if is_valid_escape_at(t, 0) {
            (*t).pos = (*t).pos + 1;
            consume_escape(t, s);
        } else {
            break;
        }
    }
    return (*s).pool.length - start;
}

// --- §4.3.12 "consume a number" ---------------------------------------------

struct CssNumber {
    value: f64,
    is_integer: bool,
}

fn consume_number(t: *CssTokenizer) -> CssNumber {
    let is_integer: bool = true;
    let sign: f64 = 1.0;
    if peek(t, 0) == '+' {
        (*t).pos = (*t).pos + 1;
    } else if peek(t, 0) == '-' {
        sign = 0.0 - 1.0;
        (*t).pos = (*t).pos + 1;
    }
    let value: f64 = 0.0;
    while is_digit(peek(t, 0)) {
        value = value * 10.0 + ((take(t) - '0') as f64);
    }
    if peek(t, 0) == '.' && is_digit(peek(t, 1)) {
        is_integer = false;
        (*t).pos = (*t).pos + 1;
        let scale: f64 = 0.1;
        while is_digit(peek(t, 0)) {
            value = value + ((take(t) - '0') as f64) * scale;
            scale = scale / 10.0;
        }
    }
    let exponent_char: u8 = peek(t, 0);
    if exponent_char == 'e' || exponent_char == 'E' {
        let after: u8 = peek(t, 1);
        let has_exponent: bool = is_digit(after);
        if (after == '+' || after == '-') && is_digit(peek(t, 2)) {
            has_exponent = true;
        }
        if has_exponent {
            is_integer = false;
            (*t).pos = (*t).pos + 1;
            let exp_sign: f64 = 1.0;
            if peek(t, 0) == '+' {
                (*t).pos = (*t).pos + 1;
            } else if peek(t, 0) == '-' {
                exp_sign = 0.0 - 1.0;
                (*t).pos = (*t).pos + 1;
            }
            let exponent: f64 = 0.0;
            while is_digit(peek(t, 0)) {
                exponent = exponent * 10.0 + ((take(t) - '0') as f64);
            }
            value = value * pow10(exp_sign * exponent);
        }
    }
    return CssNumber { value: sign * value, is_integer: is_integer };
}

fn pow10(exponent: f64) -> f64 {
    let result: f64 = 1.0;
    let count: f64 = exponent;
    if count >= 0.0 {
        while count >= 1.0 {
            result = result * 10.0;
            count = count - 1.0;
        }
    } else {
        while count <= 0.0 - 1.0 {
            result = result / 10.0;
            count = count + 1.0;
        }
    }
    return result;
}

// --- §4.3.4 "consume a string token" ----------------------------------------

fn consume_string(t: *CssTokenizer, s: *CssTokenSink, quote: u8) -> CssToken {
    let token: CssToken = tokens.empty_token();
    token.kind = tokens.kind_string();
    token.pos = (*t).pos;
    token.value_off = (*s).pool.length;
    loop {
        if at_eof(t) {
            error(t, s, tokens.err_unterminated_string());
            break;
        }
        let c: u8 = take(t);
        if c == quote {
            break;
        }
        if c == 10 as u8 {
            // A newline ends the string as a bad-string token, and the
            // newline itself is left for the next token.
            error(t, s, tokens.err_newline_in_string());
            (*t).pos = (*t).pos - 1;
            token.kind = tokens.kind_bad_string();
            break;
        }
        if c == 92 as u8 {
            if at_eof(t) {
                break;
            }
            if peek(t, 0) == 10 as u8 {
                // An escaped newline is simply removed.
                (*t).pos = (*t).pos + 1;
            } else {
                consume_escape(t, s);
            }
            continue;
        }
        pool_push(s, c);
    }
    token.value_len = (*s).pool.length - token.value_off;
    return token;
}

// --- §4.3.6 "consume a url token" -------------------------------------------
// Entered after "url(" when the contents are unquoted.
fn consume_url(t: *CssTokenizer, s: *CssTokenSink) -> CssToken {
    let token: CssToken = tokens.empty_token();
    token.kind = tokens.kind_url();
    token.pos = (*t).pos;
    while is_ws(peek(t, 0)) {
        (*t).pos = (*t).pos + 1;
    }
    token.value_off = (*s).pool.length;
    loop {
        if at_eof(t) {
            error(t, s, tokens.err_unterminated_url());
            break;
        }
        let c: u8 = take(t);
        if c == ')' {
            break;
        }
        if is_ws(c) {
            while is_ws(peek(t, 0)) {
                (*t).pos = (*t).pos + 1;
            }
            if at_eof(t) {
                error(t, s, tokens.err_unterminated_url());
                break;
            }
            if peek(t, 0) == ')' {
                (*t).pos = (*t).pos + 1;
                break;
            }
            error(t, s, tokens.err_bad_url());
            consume_bad_url_remnants(t);
            token.kind = tokens.kind_bad_url();
            break;
        }
        if c == '"' || c == 39 as u8 || c == '(' || is_non_printable(c) {
            error(t, s, tokens.err_bad_url());
            consume_bad_url_remnants(t);
            token.kind = tokens.kind_bad_url();
            break;
        }
        if c == 92 as u8 {
            (*t).pos = (*t).pos - 1;
            if is_valid_escape_at(t, 0) {
                (*t).pos = (*t).pos + 1;
                consume_escape(t, s);
                continue;
            }
            (*t).pos = (*t).pos + 1;
            error(t, s, tokens.err_bad_url());
            consume_bad_url_remnants(t);
            token.kind = tokens.kind_bad_url();
            break;
        }
        pool_push(s, c);
    }
    token.value_len = (*s).pool.length - token.value_off;
    if token.kind == tokens.kind_bad_url() {
        token.value_len = 0;
    }
    return token;
}

// --- §4.3.14 "consume the remnants of a bad url" ----------------------------

fn consume_bad_url_remnants(t: *CssTokenizer) -> void {
    loop {
        if at_eof(t) {
            return;
        }
        if is_valid_escape_at(t, 0) {
            (*t).pos = (*t).pos + 1;
            // Skip the escaped code point without recording it.
            if !at_eof(t) {
                let c: u8 = take(t);
                if is_hex(c) {
                    let digits: u64 = 1;
                    while digits < 6 && is_hex(peek(t, 0)) {
                        (*t).pos = (*t).pos + 1;
                        digits = digits + 1;
                    }
                    if is_ws(peek(t, 0)) {
                        (*t).pos = (*t).pos + 1;
                    }
                }
            }
            continue;
        }
        if take(t) == ')' {
            return;
        }
    }
}

// --- §4.3.3 "consume a numeric token" ---------------------------------------

fn consume_numeric(t: *CssTokenizer, s: *CssTokenSink) -> CssToken {
    let token: CssToken = tokens.empty_token();
    token.pos = (*t).pos;
    let number: CssNumber = consume_number(t);
    token.number = number.value;
    token.is_integer = number.is_integer;
    if would_start_ident(t, 0) {
        token.kind = tokens.kind_dimension();
        token.value_off = (*s).pool.length;
        token.value_len = consume_ident_sequence(t, s);
        return token;
    }
    if peek(t, 0) == '%' {
        (*t).pos = (*t).pos + 1;
        token.kind = tokens.kind_percentage();
        return token;
    }
    token.kind = tokens.kind_number();
    return token;
}

// --- §4.3.2 "consume an ident-like token" -----------------------------------

fn consume_ident_like(t: *CssTokenizer, s: *CssTokenSink) -> CssToken {
    let token: CssToken = tokens.empty_token();
    token.pos = (*t).pos;
    token.value_off = (*s).pool.length;
    token.value_len = consume_ident_sequence(t, s);
    if peek(t, 0) == '(' {
        let name: []const u8 = tokens.pool_bytes(s, token.value_off, token.value_len);
        if equals_ascii_ci(name, "url") {
            (*t).pos = (*t).pos + 1;
            // url( with a quoted argument is an ordinary function token, so
            // the string machinery handles escaping; only unquoted contents
            // take the url-token path.
            let scan: u64 = 0;
            while is_ws(peek(t, scan)) {
                scan = scan + 1;
            }
            let next: u8 = peek(t, scan);
            if next == '"' || next == 39 as u8 {
                token.kind = tokens.kind_function();
                return token;
            }
            // Drop the ident bytes; consume_url writes the value itself.
            (*s).pool.length = token.value_off;
            return consume_url(t, s);
        }
        (*t).pos = (*t).pos + 1;
        token.kind = tokens.kind_function();
        return token;
    }
    token.kind = tokens.kind_ident();
    return token;
}

fn equals_ascii_ci(view: []const u8, text: *u8) -> bool {
    let length: u64 = 0;
    while text[length] != 0 as u8 {
        length = length + 1;
    }
    if len(view) != length {
        return false;
    }
    for index: u64 in 0..length {
        let a: u8 = view[index];
        if is_upper(a) {
            a = a + 32 as u8;
        }
        if a != text[index] {
            return false;
        }
    }
    return true;
}

// --- §4.3.1 "consume a token" -----------------------------------------------

fn simple(kind: u8, pos: u64) -> CssToken {
    let token: CssToken = tokens.empty_token();
    token.kind = kind;
    token.pos = pos;
    return token;
}

fn delim(cp: u8, pos: u64) -> CssToken {
    let token: CssToken = tokens.empty_token();
    token.kind = tokens.kind_delim();
    token.delim = cp as u32;
    token.pos = pos;
    return token;
}

// §4.3.2 "consume comments" — comments are not tokens; they are skipped.
fn consume_comments(t: *CssTokenizer, s: *CssTokenSink) -> void {
    loop {
        if peek(t, 0) != '/' || peek(t, 1) != '*' {
            return;
        }
        (*t).pos = (*t).pos + 2;
        loop {
            if at_eof(t) {
                error(t, s, tokens.err_unterminated_comment());
                return;
            }
            if peek(t, 0) == '*' && peek(t, 1) == '/' {
                (*t).pos = (*t).pos + 2;
                break;
            }
            (*t).pos = (*t).pos + 1;
        }
    }
}

fn consume_token(t: *CssTokenizer, s: *CssTokenSink) -> CssToken {
    consume_comments(t, s);
    let start: u64 = (*t).pos;
    if at_eof(t) {
        return simple(tokens.kind_eof(), start);
    }
    let c: u8 = peek(t, 0);

    if is_ws(c) {
        while is_ws(peek(t, 0)) {
            (*t).pos = (*t).pos + 1;
        }
        return simple(tokens.kind_whitespace(), start);
    }
    if c == '"' || c == 39 as u8 {
        (*t).pos = (*t).pos + 1;
        return consume_string(t, s, c);
    }
    if c == '#' {
        if is_ident(peek(t, 1)) || is_valid_escape_at(t, 1) {
            (*t).pos = (*t).pos + 1;
            let token: CssToken = tokens.empty_token();
            token.kind = tokens.kind_hash();
            token.pos = start;
            token.hash_type = tokens.hash_unrestricted();
            if would_start_ident(t, 0) {
                token.hash_type = tokens.hash_id();
            }
            token.value_off = (*s).pool.length;
            token.value_len = consume_ident_sequence(t, s);
            return token;
        }
        (*t).pos = (*t).pos + 1;
        return delim(c, start);
    }
    if c == '(' { (*t).pos = (*t).pos + 1; return simple(tokens.kind_open_paren(), start); }
    if c == ')' { (*t).pos = (*t).pos + 1; return simple(tokens.kind_close_paren(), start); }
    if c == '[' { (*t).pos = (*t).pos + 1; return simple(tokens.kind_open_square(), start); }
    if c == ']' { (*t).pos = (*t).pos + 1; return simple(tokens.kind_close_square(), start); }
    if c == '{' { (*t).pos = (*t).pos + 1; return simple(tokens.kind_open_curly(), start); }
    if c == '}' { (*t).pos = (*t).pos + 1; return simple(tokens.kind_close_curly(), start); }
    if c == ',' { (*t).pos = (*t).pos + 1; return simple(tokens.kind_comma(), start); }
    if c == ':' { (*t).pos = (*t).pos + 1; return simple(tokens.kind_colon(), start); }
    if c == ';' { (*t).pos = (*t).pos + 1; return simple(tokens.kind_semicolon(), start); }

    if c == '+' || c == '.' {
        if would_start_number(t, 0) {
            return consume_numeric(t, s);
        }
        (*t).pos = (*t).pos + 1;
        return delim(c, start);
    }
    if c == '-' {
        if would_start_number(t, 0) {
            return consume_numeric(t, s);
        }
        if peek(t, 1) == '-' && peek(t, 2) == '>' {
            (*t).pos = (*t).pos + 3;
            return simple(tokens.kind_cdc(), start);
        }
        if would_start_ident(t, 0) {
            return consume_ident_like(t, s);
        }
        (*t).pos = (*t).pos + 1;
        return delim(c, start);
    }
    if c == '<' {
        if peek(t, 1) == '!' && peek(t, 2) == '-' && peek(t, 3) == '-' {
            (*t).pos = (*t).pos + 4;
            return simple(tokens.kind_cdo(), start);
        }
        (*t).pos = (*t).pos + 1;
        return delim(c, start);
    }
    if c == '@' {
        if would_start_ident(t, 1) {
            (*t).pos = (*t).pos + 1;
            let token: CssToken = tokens.empty_token();
            token.kind = tokens.kind_at_keyword();
            token.pos = start;
            token.value_off = (*s).pool.length;
            token.value_len = consume_ident_sequence(t, s);
            return token;
        }
        (*t).pos = (*t).pos + 1;
        return delim(c, start);
    }
    if c == 92 as u8 {
        if is_valid_escape_at(t, 0) {
            return consume_ident_like(t, s);
        }
        error(t, s, tokens.err_invalid_escape());
        (*t).pos = (*t).pos + 1;
        return delim(c, start);
    }
    if is_digit(c) {
        return consume_numeric(t, s);
    }
    if is_ident_start(c) {
        return consume_ident_like(t, s);
    }
    (*t).pos = (*t).pos + 1;
    return delim(c, start);
}

// Tokenize the whole input into `sink`, ending with an EOF token.
pub fn run(t: *CssTokenizer, s: *CssTokenSink) -> void {
    loop {
        let token: CssToken = consume_token(t, s);
        vec.push(&(*s).tokens, token);
        if token.kind == tokens.kind_eof() {
            return;
        }
    }
}
