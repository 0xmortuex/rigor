// Preprocessing the input stream — CSS Syntax Module Level 3 §3.3.
//
// Before tokenizing, CSS replaces U+000D CARRIAGE RETURN, U+000C FORM FEED and
// CRLF pairs with a single U+000A LINE FEED, and replaces U+0000 NULL and any
// surrogate code point with U+FFFD REPLACEMENT CHARACTER. The tokenizer then
// never has to consider those cases.
//
// Note the difference from HTML's §13.2.3.5, which normalizes newlines but
// passes NUL through for the tokenizer to report. CSS folds NUL away here,
// which is why the two engines keep separate preprocessing stages rather than
// sharing one.
module engine.css.preprocess;

import std.vec;

fn push_replacement(out: *Vec<u8>) -> void {
    vec.push(out, 0xEF as u8);
    vec.push(out, 0xBF as u8);
    vec.push(out, 0xBD as u8);
}

// True when the three bytes at `pos` encode a UTF-16 surrogate (U+D800 to
// U+DFFF). Such sequences are not valid UTF-8, but they do occur in the wild
// via mis-encoders, and the spec calls for replacing them.
fn is_surrogate_sequence(input: *const u8, length: u64, pos: u64) -> bool {
    if pos + 2 >= length {
        return false;
    }
    if input[pos] != 0xED as u8 {
        return false;
    }
    let second: u8 = input[pos + 1];
    return second >= 0xA0 as u8 && second <= 0xBF as u8;
}

// Copy `length` bytes from `input` into a fresh owned buffer with §3.3 applied.
// The caller owns the returned Vec.
pub fn normalize(input: *const u8, length: u64) -> Vec<u8> {
    let out: Vec<u8> = vec.with_capacity<u8>(length + 1);
    let pos: u64 = 0;
    while pos < length {
        let c: u8 = input[pos];
        if c == 13 as u8 {
            vec.push(&out, 10 as u8);
            if pos + 1 < length && input[pos + 1] == 10 as u8 {
                pos = pos + 2;
            } else {
                pos = pos + 1;
            }
        } else if c == 12 as u8 {
            vec.push(&out, 10 as u8);
            pos = pos + 1;
        } else if c == 0 as u8 {
            push_replacement(&out);
            pos = pos + 1;
        } else if is_surrogate_sequence(input, length, pos) {
            push_replacement(&out);
            pos = pos + 3;
        } else {
            vec.push(&out, c);
            pos = pos + 1;
        }
    }
    return move out;
}
