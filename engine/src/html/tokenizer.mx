    } else if c == '"' {
        error(t, s, tokens.err_missing_whitespace_after_doctype_system_keyword());
        (*t).doctype_has_system = true;
        (*t).doctype_system_off = (*s).pool.length;
        (*t).state = ST_DOCTYPE_SYSTEM_ID_DQ;
    } else if c == 39 as u8 {
        error(t, s, tokens.err_missing_whitespace_after_doctype_system_keyword());
        (*t).doctype_has_system = true;
        (*t).doctype_system_off = (*s).pool.length;
        (*t).state = ST_DOCTYPE_SYSTEM_ID_SQ;
    } else if c == '>' {
        error(t, s, tokens.err_missing_doctype_system_identifier());
        (*t).doctype_force_quirks = true;
        emit_doctype(t, s);
        (*t).state = ST_DATA;
    } else {
        error(t, s, tokens.err_missing_quote_before_doctype_system_identifier());
        (*t).doctype_force_quirks = true;
        reconsume(t, ST_BOGUS_DOCTYPE);
    }
}

// §13.2.5.64
fn before_doctype_system_id_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if at_eof(t) {
        error(t, s, tokens.err_eof_in_doctype());
        (*t).doctype_force_quirks = true;
        emit_doctype(t, s);
        emit_eof(t, s);
        return;
    }
    let c: u8 = take(t);
    if is_ws(c) {
        return;
    }
    if c == '"' {
        (*t).doctype_has_system = true;
        (*t).doctype_system_off = (*s).pool.length;
        (*t).state = ST_DOCTYPE_SYSTEM_ID_DQ;
    } else if c == 39 as u8 {
        (*t).doctype_has_system = true;
        (*t).doctype_system_off = (*s).pool.length;
        (*t).state = ST_DOCTYPE_SYSTEM_ID_SQ;
    } else if c == '>' {
        error(t, s, tokens.err_missing_doctype_system_identifier());
        (*t).doctype_force_quirks = true;
        emit_doctype(t, s);
        (*t).state = ST_DATA;
    } else {
        error(t, s, tokens.err_missing_quote_before_doctype_system_identifier());
        (*t).doctype_force_quirks = true;
        reconsume(t, ST_BOGUS_DOCTYPE);
    }
}

// §13.2.5.65 / §13.2.5.66
fn doctype_system_id_state(t: *HtmlTokenizer, s: *HtmlTokenSink, quote: u8) -> void {
    if at_eof(t) {
        error(t, s, tokens.err_eof_in_doctype());
        (*t).doctype_force_quirks = true;
        emit_doctype(t, s);
        emit_eof(t, s);
        return;
    }
    let c: u8 = take(t);
    if c == quote {
        (*t).state = ST_AFTER_DOCTYPE_SYSTEM_ID;
    } else if c == 0 as u8 {
        error(t, s, tokens.err_unexpected_null_character());
        system_push(t, s, 0xEF as u8);
        system_push(t, s, 0xBF as u8);
        system_push(t, s, 0xBD as u8);
    } else if c == '>' {
        error(t, s, tokens.err_abrupt_doctype_system_identifier());
        (*t).doctype_force_quirks = true;
        emit_doctype(t, s);
        (*t).state = ST_DATA;
    } else {
        system_push(t, s, c);
    }
}

// §13.2.5.67
fn after_doctype_system_id_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if at_eof(t) {
        error(t, s, tokens.err_eof_in_doctype());
        (*t).doctype_force_quirks = true;
        emit_doctype(t, s);
        emit_eof(t, s);
        return;
    }
    let c: u8 = take(t);
    if is_ws(c) {
        return;
    }
    if c == '>' {
        emit_doctype(t, s);
        (*t).state = ST_DATA;
    } else {
        error(t, s, tokens.err_unexpected_character_after_doctype_system_identifier());
        reconsume(t, ST_BOGUS_DOCTYPE);
    }
}

// §13.2.5.68
fn bogus_doctype_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if at_eof(t) {
        emit_doctype(t, s);
        emit_eof(t, s);
        return;
    }
    let c: u8 = take(t);
    if c == '>' {
        emit_doctype(t, s);
        (*t).state = ST_DATA;
    } else if c == 0 as u8 {
        error(t, s, tokens.err_unexpected_null_character());
    }
}

// --- Character references ----------------------------------------------------

// §13.2.5.72
fn char_ref_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if !at_eof(t) {
        let c: u8 = take(t);
        if is_alnum(c) {
            reconsume(t, ST_NAMED_CHAR_REF);
            return;
        }
        if c == '#' {
            (*t).char_ref_code = 0 as u32;
            (*t).state = ST_NUMERIC_CHAR_REF;
            return;
        }
        (*t).pos = (*t).pos - 1;
    }
    ref_flush_raw(t, s);
    (*t).state = (*t).return_state;
}

// §13.2.5.73
fn named_char_ref_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    let m: HtmlEntityMatch =
        entities.lookup((*t).input, (*t).length, (*t).pos);
    if m.len == 0 {
        // Nothing in the table matches: flush the '&' and let the ambiguous
        // ampersand state walk the alphanumerics.
        ref_flush_raw(t, s);
        (*t).state = ST_AMBIGUOUS_AMPERSAND;
        return;
    }
    (*t).pos = (*t).pos + m.len;
    if !m.semicolon && ref_in_attr(t) && !at_eof(t) {
        let next: u8 = (*t).input[(*t).pos];
        if next == '=' || is_alnum(next) {
            // Historical quirk: "&notin" in an attribute value stays literal.
            ref_flush_raw(t, s);
            (*t).state = (*t).return_state;
            return;
        }
    }
    if !m.semicolon {
        error(t, s, tokens.err_missing_semicolon_after_character_reference());
    }
    ref_emit_cp(t, s, m.cp1);
    if m.cp2 != 0 as u32 {
        ref_emit_cp(t, s, m.cp2);
    }
    (*t).state = (*t).return_state;
}

// §13.2.5.74
fn ambiguous_ampersand_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if !at_eof(t) {
        let c: u8 = take(t);
        if is_alnum(c) {
            ref_emit_byte(t, s, c);
            return;
        }
        if c == ';' {
            error(t, s, tokens.err_unknown_named_character_reference());
        }
        (*t).pos = (*t).pos - 1;
    }
    (*t).state = (*t).return_state;
}

// §13.2.5.75
fn numeric_char_ref_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if !at_eof(t) {
        let c: u8 = take(t);
        if c == 'x' || c == 'X' {
            (*t).state = ST_HEX_CHAR_REF_START;
            return;
        }
        (*t).pos = (*t).pos - 1;
    }
    (*t).state = ST_DEC_CHAR_REF_START;
}

// §13.2.5.76
fn hex_char_ref_start_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if !at_eof(t) {
        let c: u8 = (*t).input[(*t).pos];
        if is_hex(c) {
            (*t).state = ST_HEX_CHAR_REF;
            return;
        }
    }
    error(t, s, tokens.err_absence_of_digits_in_numeric_character_reference());
    ref_flush_raw(t, s);
    (*t).state = (*t).return_state;
}

// §13.2.5.77
fn dec_char_ref_start_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if !at_eof(t) {
        let c: u8 = (*t).input[(*t).pos];
        if is_digit(c) {
            (*t).state = ST_DEC_CHAR_REF;
            return;
        }
    }
    error(t, s, tokens.err_absence_of_digits_in_numeric_character_reference());
    ref_flush_raw(t, s);
    (*t).state = (*t).return_state;
}

fn accumulate_ref(t: *HtmlTokenizer, base: u32, digit: u32) -> void {
    // Saturate above the Unicode range; the end state maps it to U+FFFD.
    if (*t).char_ref_code < 0x00200000 as u32 {
        (*t).char_ref_code = (*t).char_ref_code * base + digit;
    }
}

// §13.2.5.78
fn hex_char_ref_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if !at_eof(t) {
        let c: u8 = take(t);
        if is_digit(c) {
            accumulate_ref(t, 16 as u32, (c - '0') as u32);
            return;
        }
        if c >= 'a' && c <= 'f' {
            accumulate_ref(t, 16 as u32, (c - 'a') as u32 + 10 as u32);
            return;
        }
        if c >= 'A' && c <= 'F' {
            accumulate_ref(t, 16 as u32, (c - 'A') as u32 + 10 as u32);
            return;
        }
        if c == ';' {
            numeric_ref_end(t, s);
            return;
        }
        (*t).pos = (*t).pos - 1;
    }
    error(t, s, tokens.err_missing_semicolon_after_character_reference());
    numeric_ref_end(t, s);
}

// §13.2.5.79
fn dec_char_ref_state(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    if !at_eof(t) {
        let c: u8 = take(t);
        if is_digit(c) {
            accumulate_ref(t, 10 as u32, (c - '0') as u32);
            return;
        }
        if c == ';' {
            numeric_ref_end(t, s);
            return;
        }
        (*t).pos = (*t).pos - 1;
    }
    error(t, s, tokens.err_missing_semicolon_after_character_reference());
    numeric_ref_end(t, s);
}

// §13.2.5.80 — numeric character reference end state. Operates on the
// accumulated code without consuming input, then returns to the return state.
fn numeric_ref_end(t: *HtmlTokenizer, s: *HtmlTokenSink) -> void {
    let code: u32 = (*t).char_ref_code;
    if code == 0 as u32 {
        error(t, s, tokens.err_null_character_reference());
        code = 0xFFFD as u32;
    } else if code > 0x10FFFF as u32 {
        error(t, s, tokens.err_character_reference_outside_unicode_range());
        code = 0xFFFD as u32;
    } else if code >= 0xD800 as u32 && code <= 0xDFFF as u32 {
        error(t, s, tokens.err_surrogate_character_reference());
        code = 0xFFFD as u32;
    } else if is_noncharacter(code) {
        error(t, s, tokens.err_noncharacter_character_reference());
    } else if code == 0x0D as u32
        || (is_control_cp(code) && !is_ws_cp(code)) {
        error(t, s, tokens.err_control_character_reference());
        code = map_c1(code);
    }
    ref_emit_cp(t, s, code);
    (*t).state = (*t).return_state;
}

fn is_noncharacter(code: u32) -> bool {
    if code >= 0xFDD0 as u32 && code <= 0xFDEF as u32 {
        return true;
    }
    let low: u32 = code & (0xFFFF as u32);
    return low == 0xFFFE as u32 || low == 0xFFFF as u32;
}

fn is_control_cp(code: u32) -> bool {
    return code <= 0x1F as u32
        || (code >= 0x7F as u32 && code <= 0x9F as u32);
}

fn is_ws_cp(code: u32) -> bool {
    return code == 0x09 as u32 || code == 0x0A as u32
        || code == 0x0C as u32 || code == 0x0D as u32
        || code == 0x20 as u32;
}

// The spec's C1-controls mapping table (§13.2.5.80). Codes not listed map to
// themselves.
fn map_c1(code: u32) -> u32 {
    if code == 0x80 as u32 { return 0x20AC as u32; }
    if code == 0x82 as u32 { return 0x201A as u32; }
    if code == 0x83 as u32 { return 0x0192 as u32; }
    if code == 0x84 as u32 { return 0x201E as u32; }
    if code == 0x85 as u32 { return 0x2026 as u32; }
    if code == 0x86 as u32 { return 0x2020 as u32; }
    if code == 0x87 as u32 { return 0x2021 as u32; }
    if code == 0x88 as u32 { return 0x02C6 as u32; }
    if code == 0x89 as u32 { return 0x2030 as u32; }
    if code == 0x8A as u32 { return 0x0160 as u32; }
    if code == 0x8B as u32 { return 0x2039 as u32; }
    if code == 0x8C as u32 { return 0x0152 as u32; }
    if code == 0x8E as u32 { return 0x017D as u32; }
    if code == 0x91 as u32 { return 0x2018 as u32; }
    if code == 0x92 as u32 { return 0x2019 as u32; }
    if code == 0x93 as u32 { return 0x201C as u32; }
    if code == 0x94 as u32 { return 0x201D as u32; }
    if code == 0x95 as u32 { return 0x2022 as u32; }
    if code == 0x96 as u32 { return 0x2013 as u32; }
    if code == 0x97 as u32 { return 0x2014 as u32; }
    if code == 0x98 as u32 { return 0x02DC as u32; }
    if code == 0x99 as u32 { return 0x2122 as u32; }
    if code == 0x9A as u32 { return 0x0161 as u32; }
    if code == 0x9B as u32 { return 0x203A as u32; }
    if code == 0x9C as u32 { return 0x0153 as u32; }
    if code == 0x9E as u32 { return 0x017E as u32; }
    if code == 0x9F as u32 { return 0x0178 as u32; }
    return code;
}
