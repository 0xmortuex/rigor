// Normal flow layout — CSS 2.1 §9 and §10.
//
// Two passes. `build` turns the DOM plus computed styles into a box tree,
// generating the anonymous block boxes the model requires; `layout` then
// assigns geometry, walking the tree once and resolving each box against its
// containing block.
//
// Implemented: block-level boxes in normal flow, the width constraint of
// §10.3.3 (including `auto` margins centring a box), auto and fixed heights,
// margin collapsing in all three of its forms (between siblings, between a
// parent and its first or last child, and through a box with nothing in it),
// floats with `clear` and line boxes that shorten around them (§9.5), and
// inline formatting with line boxes, white-space processing, horizontal
// borders and padding on inline boxes, text-align, and line breaking at the
// opportunities UAX #14 finds (engine.text.linebreak) rather than at spaces.
//
// Not implemented, and noted where each would go: positioning other than
// static, vertical margins and vertical borders on inline boxes (which do not
// affect line height, per §10.8, but should still paint), vertical-align other
// than baseline, nested block formatting contexts, and table layout (table
// boxes lay out as ordinary blocks, which is enough to see them but not to
// align columns).
module engine.layout.flow;

import std.vec;
import box;
import metrics;
import floats;
import intrinsic;
import engine.dom.node;
import engine.html.tagnames;
import engine.image.store;
import engine.style.computed;
import engine.text.fonts;
import engine.text.utf8;
import engine.text.linebreak;

// --- Box tree construction ---------------------------------------------------

fn is_block_level(display: u8) -> bool {
    return display == computed.display_block()
        || display == computed.display_list_item()
        || display == computed.display_table()
        || display == computed.display_table_row()
        || display == computed.display_table_cell()
        || display == computed.display_table_row_group();
}

fn style_of(styles: *StyleTree, dom_node: u64) -> ComputedStyle {
    return computed.get(styles, dom_node);
}

fn is_space_byte(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 12 as u8
        || c == 13 as u8;
}

fn is_all_whitespace(view: []const u8) -> bool {
    for index: u64 in 0..len(view) {
        if !is_space_byte(view[index]) {
            return false;
        }
    }
    return true;
}

// Does this element have any block-level child box? That decides whether its
// inline children need anonymous block wrappers (CSS 2.1 §9.2.1.1).
fn has_block_children(
    doc: *DomDocument,
    styles: *StyleTree,
    dom_parent: u64
) -> bool {
    let child: u64 = node.get(doc, dom_parent).first_child;
    while child != node.none() {
        let child_node: DomNode = node.get(doc, child);
        if child_node.kind == node.kind_element() {
            let display: u8 = style_of(styles, child).display;
            if display != computed.display_none() && is_block_level(display) {
                return true;
            }
        }
        child = child_node.next_sibling;
    }
    return false;
}

struct BuildContext {
    anonymous: u64,
    needs_anonymous: bool,
}

fn inline_parent(
    tree: *LayoutTree,
    parent_box: u64,
    style_node: u64,
    context: *BuildContext
) -> u64 {
    if !(*context).needs_anonymous {
        return parent_box;
    }
    if (*context).anonymous == box.none() {
        let anonymous: u64 =
            box.create(tree, box.box_anonymous(), node.none(), style_node);
        box.append_child(tree, parent_box, anonymous);
        (*context).anonymous = anonymous;
    }
    return (*context).anonymous;
}

fn build_children(
    doc: *DomDocument,
    styles: *StyleTree,
    tree: *LayoutTree,
    images: *ImageStore,
    dom_parent: u64,
    parent_box: u64,
    style_node: u64
) -> void {
    let context: BuildContext = BuildContext {
        anonymous: box.none(),
        needs_anonymous: has_block_children(doc, styles, dom_parent),
    };
    let child: u64 = node.get(doc, dom_parent).first_child;
    while child != node.none() {
        let child_node: DomNode = node.get(doc, child);
        if child_node.kind == node.kind_text() {
            let text: []const u8 =
                node.bytes(doc, child_node.data_off, child_node.data_len);
            // Whitespace between block-level siblings generates no box.
            let drop: bool = context.needs_anonymous && is_all_whitespace(text);
            if !drop && child_node.data_len > 0 {
                let target: u64 =
                    inline_parent(tree, parent_box, style_node, &context);
                let text_box: u64 =
                    box.create(tree, box.box_text(), child, style_node);
                box.append_child(tree, target, text_box);
            }
        } else if child_node.kind == node.kind_element() {
            let display: u8 = style_of(styles, child).display;
            if display != computed.display_none() {
                if is_block_level(display) {
                    // A block ends whatever anonymous run was open.
                    context.anonymous = box.none();
                    let block: u64 = box.create(tree, box.box_block(), child, child);
                    box.append_child(tree, parent_box, block);
                    build_children(doc, styles, tree, images, child, block,
                        child);
                } else if is_replaced(doc, images, child) {
                    // A replaced element has no children to lay out: its
                    // content is the image.
                    let target: u64 =
                        inline_parent(tree, parent_box, style_node, &context);
                    let replaced: u64 =
                        box.create(tree, box.box_replaced(), child, child);
                    box.append_child(tree, target, replaced);
                } else {
                    let target: u64 =
                        inline_parent(tree, parent_box, style_node, &context);
                    let inline_box: u64 =
                        box.create(tree, box.box_inline(), child, child);
                    box.append_child(tree, target, inline_box);
                    build_children(doc, styles, tree, images, child,
                        inline_box, child);
                }
            }
        }
        child = child_node.next_sibling;
    }
}

// Build the box tree for `doc`. A document whose root element is
// `display: none` produces no boxes at all.
// The <img> elements a document references, so build() knows which elements
// are replaced. Set for the duration of one build; a null store simply means no
// element is replaced, which is what a caller with no images passes.
fn is_replaced(doc: *DomDocument, images: *ImageStore, dom_node: u64) -> bool {
    if images == 0 as *ImageStore {
        return false;
    }
    if node.get(doc, dom_node).tag != tagnames.tag_img() {
        return false;
    }
    return !store.is_missing(store.find(images, dom_node));
}

pub fn build(
    doc: *DomDocument,
    styles: *StyleTree,
    tree: *LayoutTree,
    images: *ImageStore
) -> void {
    let child: u64 = node.get(doc, 0).first_child;
    while child != node.none() {
        let child_node: DomNode = node.get(doc, child);
        if child_node.kind == node.kind_element() {
            let display: u8 = style_of(styles, child).display;
            if display != computed.display_none() {
                let root: u64 = box.create(tree, box.box_block(), child, child);
                (*tree).root = root;
                build_children(doc, styles, tree, images, child, root, child);
                return;
            }
        }
        child = child_node.next_sibling;
    }
}

// --- Used value resolution ---------------------------------------------------

fn resolve(length: StyleLength, containing: f64) -> f64 {
    if length.kind == computed.length_percent() {
        return containing * length.value / 100.0;
    }
    if length.kind == computed.length_auto() {
        return 0.0;
    }
    return length.value;
}

fn is_auto(length: StyleLength) -> bool {
    return length.kind == computed.length_auto();
}

fn larger(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    return b;
}

fn is_floated(styles: *StyleTree, tree: *LayoutTree, index: u64) -> bool {
    let box_value: LayoutBox = box.get(tree, index);
    if box_value.kind != box.box_block() {
        return false;
    }
    return style_of(styles, box_value.style_node).float_side
        != computed.float_none();
}

// --- Margin collapsing (§8.3.1) ----------------------------------------------
//
// Three cases, and they compose: two siblings' adjoining margins collapse to
// the larger; a parent's top margin collapses with its first child's when
// nothing (border, padding, inline content) separates them, and likewise at the
// bottom; and a box with nothing in it at all collapses its own two margins
// together, so an empty div between two paragraphs adds no gap of its own.
//
// The collapsed value is needed *before* a box is laid out, because it decides
// where the box goes — so these walk the box tree by style rather than reading
// geometry that does not exist yet.

fn zero_length(length: StyleLength, containing: f64) -> bool {
    return resolve(length, containing) == 0.0;
}

// The first block-level child that participates in collapsing: an in-flow
// block. Inline content between a parent and its first block child stops the
// collapse, which is why anonymous boxes count as content rather than being
// walked through.
fn first_collapsible_child(
    tree: *LayoutTree,
    styles: *StyleTree,
    index: u64
) -> u64 {
    let child: u64 = box.get(tree, index).first_child;
    while child != box.none() {
        let child_box: LayoutBox = box.get(tree, child);
        if child_box.kind != box.box_block() {
            return box.none();
        }
        if !is_floated(styles, tree, child) {
            return child;
        }
        child = child_box.next_sibling;
    }
    return box.none();
}

fn last_collapsible_child(
    tree: *LayoutTree,
    styles: *StyleTree,
    index: u64
) -> u64 {
    let found: u64 = box.none();
    let child: u64 = box.get(tree, index).first_child;
    while child != box.none() {
        let child_box: LayoutBox = box.get(tree, child);
        if child_box.kind != box.box_block() {
            return box.none();
        }
        if !is_floated(styles, tree, child) {
            found = child;
        }
        child = child_box.next_sibling;
    }
    return found;
}

// Does this box's own top margin adjoin its first child's?
fn top_adjoins_children(style: ComputedStyle, containing: f64) -> bool {
    return style.border_top_width == 0.0
        && zero_length(style.padding_top, containing);
}

// And its bottom margin its last child's? A fixed height separates them, since
// the height is what the margin sits below.
fn bottom_adjoins_children(style: ComputedStyle, containing: f64) -> bool {
    return style.border_bottom_width == 0.0
        && zero_length(style.padding_bottom, containing)
        && is_auto(style.height);
}

// A box whose top and bottom margins collapse *through* it: nothing inside,
// no border or padding, and no height to speak of.
fn collapses_through(
    tree: *LayoutTree,
    styles: *StyleTree,
    index: u64,
    style: ComputedStyle,
    containing: f64
) -> bool {
    if box.get(tree, index).first_child != box.none() {
        return false;
    }
    if !is_auto(style.height) && resolve(style.height, containing) != 0.0 {
        return false;
    }
    return top_adjoins_children(style, containing)
        && style.border_bottom_width == 0.0
        && zero_length(style.padding_bottom, containing);
}

fn collapsed_top_margin(
    tree: *LayoutTree,
    styles: *StyleTree,
    index: u64,
    containing: f64
) -> f64 {
    let box_value: LayoutBox = box.get(tree, index);
    if box_value.kind != box.box_block() {
        return 0.0;
    }
    let style: ComputedStyle = style_of(styles, box_value.style_node);
    if style.float_side != computed.float_none() {
        // A float's margins never collapse with anything (§8.3.1).
        return 0.0;
    }
    let own: f64 = resolve(style.margin_top, containing);
    if collapses_through(tree, styles, index, style, containing) {
        return larger(own, resolve(style.margin_bottom, containing));
    }
    if !top_adjoins_children(style, containing) {
        return own;
    }
    let child: u64 = first_collapsible_child(tree, styles, index);
    if child == box.none() {
        return own;
    }
    return larger(own,
        collapsed_top_margin(tree, styles, child, containing));
}

fn collapsed_bottom_margin(
    tree: *LayoutTree,
    styles: *StyleTree,
    index: u64,
    containing: f64
) -> f64 {
    let box_value: LayoutBox = box.get(tree, index);
    if box_value.kind != box.box_block() {
        return 0.0;
    }
    let style: ComputedStyle = style_of(styles, box_value.style_node);
    if style.float_side != computed.float_none() {
        return 0.0;
    }
    let own: f64 = resolve(style.margin_bottom, containing);
    if collapses_through(tree, styles, index, style, containing) {
        return larger(own, resolve(style.margin_top, containing));
    }
    if !bottom_adjoins_children(style, containing) {
        return own;
    }
    let child: u64 = last_collapsible_child(tree, styles, index);
    if child == box.none() {
        return own;
    }
    return larger(own,
        collapsed_bottom_margin(tree, styles, child, containing));
}

// --- Block layout ------------------------------------------------------------

// Lay out `box_index` as a block-level box. `x` is the left content edge of
// the containing block and `y` is this box's final border-box top, which the
// caller has already adjusted for collapsed margins.
fn layout_block(
    doc: *DomDocument,
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    context: *FloatContext,
    images: *ImageStore,
    box_index: u64,
    x: f64,
    y: f64,
    containing_width: f64,
    // A float's width is decided by its caller from the intrinsic sizes;
    // negative means "work it out from §10.3.3 as usual".
    forced_width: f64
) -> void {
    let current: LayoutBox = box.get(tree, box_index);
    let style: ComputedStyle = style_of(styles, current.style_node);
    // An anonymous box has no margins, borders or padding of its own; it is a
    // pure container for inline content.
    let anonymous: bool = current.kind == box.box_anonymous();

    if !anonymous {
        current.border_top = style.border_top_width;
        current.border_right = style.border_right_width;
        current.border_bottom = style.border_bottom_width;
        current.border_left = style.border_left_width;
        current.padding_top = resolve(style.padding_top, containing_width);
        current.padding_right = resolve(style.padding_right, containing_width);
        current.padding_bottom = resolve(style.padding_bottom, containing_width);
        current.padding_left = resolve(style.padding_left, containing_width);
        current.margin_top = resolve(style.margin_top, containing_width);
        current.margin_bottom = resolve(style.margin_bottom, containing_width);
    }
    let edges: f64 = current.border_left + current.border_right
        + current.padding_left + current.padding_right;

    let width: f64 = 0.0;
    if anonymous {
        width = containing_width;
    } else if forced_width >= 0.0 {
        // §10.3.5: a float's own margins do not absorb slack, so they stay as
        // declared and `auto` becomes zero.
        width = forced_width;
        current.margin_left = resolve(style.margin_left, containing_width);
        current.margin_right = resolve(style.margin_right, containing_width);
    } else {
        // §10.3.3: margin-left + border + padding + width + padding + border +
        // margin-right must equal the containing block's width.
        let margin_left: f64 = resolve(style.margin_left, containing_width);
        let margin_right: f64 = resolve(style.margin_right, containing_width);
        let left_auto: bool = is_auto(style.margin_left);
        let right_auto: bool = is_auto(style.margin_right);
        if is_auto(style.width) {
            // An auto width absorbs the slack, so auto margins beside it are
            // treated as zero.
            width = containing_width - edges - margin_left - margin_right;
        } else {
            width = resolve(style.width, containing_width);
            let slack: f64 =
                containing_width - edges - width - margin_left - margin_right;
            if left_auto && right_auto {
                margin_left = slack / 2.0;
                margin_right = slack / 2.0;
            } else if left_auto {
                margin_left = slack;
            } else if right_auto {
                margin_right = slack;
            } else {
                // Over-constrained: margin-right is the one that gives way.
                margin_right = margin_right + slack;
            }
        }
        current.margin_left = margin_left;
        current.margin_right = margin_right;
    }
    if width < 0.0 {
        width = 0.0;
    }
    current.width = width;
    current.x = x + current.margin_left;
    current.y = y;
    box.set(tree, box_index, current);

    let content_x: f64 = current.x + current.border_left + current.padding_left;
    let content_y: f64 = current.y + current.border_top + current.padding_top;

    let content_height: f64 = 0.0;
    if first_child_is_inline(tree, box_index) {
        content_height = layout_inline_content(doc, tree, styles, set, context,
            images, box_index, content_x, content_y, width);
    } else {
        // Whether this box's own margins adjoin its children's decides whether
        // the first child's margin was already applied above this box.
        let collapse_top: bool = !anonymous
            && top_adjoins_children(style, containing_width)
            && style.float_side == computed.float_none();
        let collapse_bottom: bool = !anonymous
            && bottom_adjoins_children(style, containing_width)
            && style.float_side == computed.float_none();
        content_height = layout_block_children(doc, tree, styles, set, context, images,
            box_index, content_x, content_y, width, collapse_top,
            collapse_bottom);
    }

    current = box.get(tree, box_index);
    if anonymous || is_auto(style.height) {
        current.height = content_height;
    } else {
        current.height = resolve(style.height, containing_width);
    }
    box.set(tree, box_index, current);
}

// Lay out a float and record it in the context. §9.5.1: it is placed as high as
// the current position allows and as far to its side as it can go without
// overlapping a float already there, dropping to the next band when it will not
// fit.
fn layout_float(
    doc: *DomDocument,
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    context: *FloatContext,
    images: *ImageStore,
    child: u64,
    content_x: f64,
    top: f64,
    containing_width: f64
) -> void {
    let style: ComputedStyle = style_of(styles, box.get(tree, child).style_node);
    let side: u8 = style.float_side;

    let margin_left: f64 = resolve(style.margin_left, containing_width);
    let margin_right: f64 = resolve(style.margin_right, containing_width);
    let edges: f64 = style.border_left_width + style.border_right_width
        + resolve(style.padding_left, containing_width)
        + resolve(style.padding_right, containing_width);

    let width: f64 = 0.0;
    if is_auto(style.width) {
        // §10.3.5 shrink-to-fit, measured over the box's own content.
        let available: f64 =
            containing_width - margin_left - margin_right - edges;
        let sizes: IntrinsicWidths =
            intrinsic.widths(doc, tree, styles, set, child, containing_width);
        // The intrinsic widths include this box's own edges, which the
        // available width already accounts for.
        let content: IntrinsicWidths = IntrinsicWidths {
            min: sizes.min - edges - margin_left - margin_right,
            max: sizes.max - edges - margin_left - margin_right,
        };
        width = intrinsic.shrink_to_fit(available, content);
    } else {
        width = resolve(style.width, containing_width);
    }
    if width < 0.0 {
        width = 0.0;
    }

    let outer: f64 = width + edges + margin_left + margin_right;
    let start: f64 = floats.clearance(context, top, style.clear_side);
    let spot: FloatPlacement = floats.place(context, start, outer, side,
        content_x, content_x + containing_width);

    layout_block(doc, tree, styles, set, context, images, child, spot.x,
        spot.y + resolve(style.margin_top, containing_width), containing_width,
        width);

    let placed: LayoutBox = box.get(tree, child);
    let margin_top: f64 = placed.margin_top;
    let margin_bottom: f64 = placed.margin_bottom;
    floats.add(context, spot.x, spot.y, spot.x + outer,
        placed.y + box.border_box_height(placed) + margin_bottom, side);
}

fn first_child_is_inline(tree: *LayoutTree, box_index: u64) -> bool {
    let first: u64 = box.get(tree, box_index).first_child;
    if first == box.none() {
        return false;
    }
    let kind: u8 = box.get(tree, first).kind;
    return kind == box.box_inline() || kind == box.box_text()
        || kind == box.box_replaced();
}

// Stack block children vertically, collapsing adjacent sibling margins.
fn layout_block_children(
    doc: *DomDocument,
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    context: *FloatContext,
    images: *ImageStore,
    parent: u64,
    content_x: f64,
    content_y: f64,
    content_width: f64,
    collapse_top: bool,
    collapse_bottom: bool
) -> f64 {
    let cursor: f64 = content_y;
    let previous_bottom: f64 = 0.0;
    let trailing_margin: f64 = 0.0;
    let first: bool = true;
    let child: u64 = box.get(tree, parent).first_child;
    while child != box.none() {
        let next: u64 = box.get(tree, child).next_sibling;
        if is_floated(styles, tree, child) {
            // Out of flow: it does not move the cursor, and the next in-flow
            // box's margins are unaffected by it.
            layout_float(doc, tree, styles, set, context, images, child,
                content_x, cursor, content_width);
            child = next;
            continue;
        }
        let top_margin: f64 =
            collapsed_top_margin(tree, styles, child, content_width);
        // §8.3.1: adjoining margins collapse to the larger of the two rather
        // than summing. The first child's margin has already been applied
        // above this box when the two adjoin, so the gap here is nothing.
        let gap: f64 = top_margin;
        if first {
            if collapse_top {
                gap = 0.0;
            }
        } else {
            gap = larger(previous_bottom, top_margin);
        }
        let child_y: f64 = cursor + gap;
        // §9.5.2: clearance moves the box below the floats it clears.
        let child_style: ComputedStyle =
            style_of(styles, box.get(tree, child).style_node);
        child_y = floats.clearance(context, child_y, child_style.clear_side);
        layout_block(doc, tree, styles, set, context, images, child,
            content_x, child_y, content_width, -1.0);
        let placed: LayoutBox = box.get(tree, child);
        cursor = placed.y + box.border_box_height(placed);
        previous_bottom =
            collapsed_bottom_margin(tree, styles, child, content_width);
        trailing_margin = previous_bottom;
        first = false;
        child = next;
    }
    // The last child's bottom margin escapes this box when the two adjoin —
    // the parent's own collapsed margin carries it — and is part of the
    // content height when they do not.
    if collapse_bottom {
        return cursor - content_y;
    }
    return cursor - content_y + trailing_margin;
}

// --- Inline layout -----------------------------------------------------------

struct InlineState {
    container: u64,
    x: f64,
    line_top: f64,
    line_height: f64,
    // Whether a collapsible space is pending before the next word.
    pending_space: bool,
    line_empty: bool,
    origin_x: f64,
    available: f64,
    // The fragment most recently emitted on this line. A space that separates
    // two elements — the one in `in <b>Mort</b>` — belongs to the text run
    // before it, not to the element after, so it is appended here rather than
    // opening the next fragment.
    last_fragment: u64,
    // The box a newly created fragment is inserted after, which is the text
    // box itself for the first fragment and the previous fragment after that.
    previous_fragment: u64,
    // The containing block's own content edges, which a line box starts from
    // before floats narrow it.
    edge_left: f64,
    edge_right: f64,
    context: *FloatContext,
    images: *ImageStore,
}

// §9.5: a line box beside a float is only as wide as the space the float
// leaves. Called when a line starts, since the floats a line meets depend on
// where that line sits.
fn apply_float_band(state: *InlineState) -> void {
    let context: *FloatContext = (*state).context;
    // Probe a one-pixel band at the line's top: the line's own height is not
    // known until content is placed on it, and this is where every engine
    // makes the same approximation.
    let available: FloatBand = floats.band(context, (*state).line_top,
        (*state).line_top + 1.0, (*state).edge_left, (*state).edge_right);
    // A band with nothing left in it means the floats meet; drop past the
    // nearest one and try again.
    for step: u64 in 0..(floats.count(context) + 1) {
        if available.right - available.left > 0.0 {
            break;
        }
        let next: f64 = floats.next_band(context, (*state).line_top);
        if next <= (*state).line_top {
            break;
        }
        (*state).line_top = next;
        available = floats.band(context, (*state).line_top,
            (*state).line_top + 1.0, (*state).edge_left, (*state).edge_right);
    }
    (*state).origin_x = available.left;
    (*state).available = available.right - available.left;
    if (*state).line_empty {
        (*state).x = available.left;
    }
}

fn layout_inline_content(
    doc: *DomDocument,
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    context: *FloatContext,
    images: *ImageStore,
    container: u64,
    content_x: f64,
    content_y: f64,
    content_width: f64
) -> f64 {
    let state: InlineState = InlineState {
        container: container,
        x: content_x,
        line_top: content_y,
        line_height: 0.0,
        pending_space: false,
        line_empty: true,
        origin_x: content_x,
        available: content_width,
        last_fragment: box.none(),
        previous_fragment: box.none(),
        edge_left: content_x,
        edge_right: content_x + content_width,
        context: context,
        images: images,
    };
    apply_float_band(&state);
    layout_inline_children(doc, tree, styles, set, container, &state);
    if !state.line_empty {
        align_line(tree, styles, set, &state);
        return state.line_top + state.line_height - content_y;
    }
    return state.line_top - content_y;
}

// Where the first text fragment inside `index` was placed, or `fallback` when
// there is none.
fn first_fragment_x(tree: *LayoutTree, index: u64, fallback: f64) -> f64 {
    let child: u64 = box.get(tree, index).first_child;
    while child != box.none() {
        let child_box: LayoutBox = box.get(tree, child);
        if child_box.kind == box.box_text() && child_box.text_len > 0 {
            return child_box.x;
        }
        if child_box.kind == box.box_inline() {
            let inner: f64 = first_fragment_x(tree, child, fallback);
            if inner != fallback {
                return inner;
            }
        }
        child = child_box.next_sibling;
    }
    return fallback;
}

fn layout_inline_children(
    doc: *DomDocument,
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    parent: u64,
    state: *InlineState
) -> void {
    let child: u64 = box.get(tree, parent).first_child;
    while child != box.none() {
        let child_box: LayoutBox = box.get(tree, child);
        let next: u64 = child_box.next_sibling;
        if child_box.kind == box.box_text() {
            place_text(doc, tree, styles, set, child, state);
        } else if child_box.kind == box.box_replaced() {
            place_replaced(tree, styles, set, child, state);
        } else if child_box.kind == box.box_inline() {
            // §10.8: horizontal margins, borders and padding on an inline box
            // do take up room on the line, even though the vertical ones do
            // not affect line height. The box's own geometry is the extent of
            // its fragments plus those edges.
            let style: ComputedStyle = style_of(styles, child_box.style_node);
            let containing: f64 = (*state).edge_right - (*state).edge_left;
            emit_pending_space(tree, styles, set, state);
            let margin_left: f64 = resolve(style.margin_left, containing);
            let margin_right: f64 = resolve(style.margin_right, containing);
            let padding_left: f64 = resolve(style.padding_left, containing);
            let padding_right: f64 = resolve(style.padding_right, containing);

            (*state).x = (*state).x
                + margin_left + style.border_left_width + padding_left;
            let content_start: f64 = (*state).x;
            let start_y: f64 = (*state).line_top;
            layout_inline_children(doc, tree, styles, set, child, state);
            let content_end: f64 = (*state).x;
            (*state).x = (*state).x
                + padding_right + style.border_right_width + margin_right;

            let updated: LayoutBox = box.get(tree, child);
            updated.margin_left = margin_left;
            updated.margin_right = margin_right;
            updated.border_left = style.border_left_width;
            updated.border_right = style.border_right_width;
            updated.padding_left = padding_left;
            updated.padding_right = padding_right;
            updated.padding_top = resolve(style.padding_top, containing);
            updated.padding_bottom = resolve(style.padding_bottom, containing);
            updated.border_top = style.border_top_width;
            updated.border_bottom = style.border_bottom_width;
            // The box begins where its content actually landed. That is
            // usually `content_start`, but a collapsible space just before the
            // box belongs to the text run outside it — so the content starts
            // one space further right, and the box must not reach back over a
            // space it does not contain.
            let placed_start: f64 = first_fragment_x(tree, child, content_start);
            updated.x = placed_start - style.border_left_width - padding_left;
            updated.y = start_y;
            updated.width = content_end - placed_start;
            if updated.width < 0.0 {
                updated.width = 0.0;
            }
            updated.height = (*state).line_top + (*state).line_height - start_y
                - updated.border_top - updated.padding_top
                - updated.border_bottom - updated.padding_bottom;
            if updated.height < 0.0 {
                updated.height = 0.0;
            }
            box.set(tree, child, updated);
        }
        child = next;
    }
}

// Emit the collapsible space that is waiting before the next thing on the
// line. §16.6.1 makes it one space wide; it belongs to the run *before* it, so
// it extends that fragment rather than opening a new one — which is what keeps
// `in <b>bold</b>` from putting the space inside the <b>.
fn emit_pending_space(
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    state: *InlineState
) -> void {
    if !(*state).pending_space {
        return;
    }
    (*state).pending_space = false;
    if (*state).last_fragment == box.none() {
        return;
    }
    let previous: LayoutBox = box.get(tree, (*state).last_fragment);
    let style: ComputedStyle = style_of(styles, previous.style_node);
    let width: f64 = metrics.codepoint_width(set, style, ' ' as u32);
    // The previous fragment's bytes end the text buffer, so extending it is
    // just a longer length.
    box.push_byte(tree, ' ');
    previous.text_len = previous.text_len + 1;
    previous.width = previous.width + width;
    box.set(tree, (*state).last_fragment, previous);
    (*state).x = (*state).x + width;
}

// Put a replaced element on the line, wrapping first when it does not fit.
//
// §10.3.2 and §10.4.2: the used width and height come from the declared ones
// where they are given, and from the image's own size where they are not — with
// one declared dimension scaling the other by the intrinsic ratio, which is
// what stops a `width: 200px` on a photo squashing it.
fn place_replaced(
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    box_index: u64,
    state: *InlineState
) -> void {
    emit_pending_space(tree, styles, set, state);
    let current: LayoutBox = box.get(tree, box_index);
    let style: ComputedStyle = style_of(styles, current.style_node);
    let entry: ImageEntry = store.find((*state).images, current.node);
    let containing: f64 = (*state).edge_right - (*state).edge_left;

    let natural_width: f64 = entry.width as f64;
    let natural_height: f64 = entry.height as f64;
    let width: f64 = natural_width;
    let height: f64 = natural_height;
    let has_width: bool = !is_auto(style.width);
    let has_height: bool = !is_auto(style.height);
    if has_width {
        width = resolve(style.width, containing);
    }
    if has_height {
        height = resolve(style.height, containing);
    }
    if has_width && !has_height && natural_width > 0.0 {
        height = width * natural_height / natural_width;
    }
    if has_height && !has_width && natural_height > 0.0 {
        width = height * natural_width / natural_height;
    }

    let padding_left: f64 = resolve(style.padding_left, containing);
    let padding_right: f64 = resolve(style.padding_right, containing);
    let outer: f64 = width + padding_left + padding_right
        + style.border_left_width + style.border_right_width;

    if !(*state).line_empty
        && (*state).x + outer > (*state).origin_x + (*state).available {
        break_line(tree, styles, set, state);
    }
    current.x = (*state).x;
    current.y = (*state).line_top;
    current.width = width;
    current.height = height;
    current.padding_left = padding_left;
    current.padding_right = padding_right;
    current.padding_top = resolve(style.padding_top, containing);
    current.padding_bottom = resolve(style.padding_bottom, containing);
    current.border_left = style.border_left_width;
    current.border_right = style.border_right_width;
    current.border_top = style.border_top_width;
    current.border_bottom = style.border_bottom_width;
    // §10.8: an inline-level replaced box sits on the baseline.
    current.baseline = box.border_box_height(current);
    box.set(tree, box_index, current);

    (*state).x = (*state).x + outer;
    (*state).line_empty = false;
    (*state).last_fragment = box.none();
    grow_line(state, box.border_box_height(current));
    grow_line(state, style.line_height);
}

// Break one text node into fragments and place them on lines. Reads from the
// DOM rather than the layout tree's own buffer, because that buffer is being
// appended to here and its backing store may move.
fn place_text(
    doc: *DomDocument,
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    text_box: u64,
    state: *InlineState
) -> void {
    let current: LayoutBox = box.get(tree, text_box);
    let style: ComputedStyle = style_of(styles, current.style_node);
    let font_size: f64 = style.font_size;
    let preserve: bool = style.white_space == computed.white_space_pre();
    let nowrap: bool = style.white_space == computed.white_space_nowrap();

    let source_node: DomNode = node.get(doc, current.node);
    let source_off: u64 = source_node.data_off;
    let source_len: u64 = source_node.data_len;

    let fragment_start: u64 = box.text_length(tree);
    let fragment_width: f64 = 0.0;
    let first_fragment: bool = true;
    let index: u64 = 0;
    (*state).previous_fragment = text_box;
    // Reused across every word in this text node rather than allocated per
    // word, since a paragraph has a lot of words and none of them need the
    // buffer to outlive them.
    let breaks: Vec<u64> = vec.new<u64>();

    while index < source_len {
        let c: u8 = dom_byte(doc, source_off, index);

        if preserve {
            if c == 10 as u8 {
                first_fragment = flush_fragment(tree, styles, set, text_box, state,
                    fragment_start, fragment_width, first_fragment);
                break_line(tree, styles, set, state);
                fragment_start = box.text_length(tree);
                fragment_width = 0.0;
                index = index + 1;
                continue;
            }
            // Preserved text still has to advance a whole character at a time,
            // so a multi-byte sequence is measured once rather than per byte.
            let source_view: []const u8 =
                node.bytes(doc, source_off + index, source_len - index);
            let decoded: TextChar = utf8.decode(source_view, 0);
            for step: u64 in 0..decoded.size {
                box.push_byte(tree, dom_byte(doc, source_off, index + step));
            }
            let advance: f64 =
                metrics.codepoint_width(set, style, decoded.codepoint);
            fragment_width = fragment_width + advance;
            (*state).x = (*state).x + advance;
            (*state).line_empty = false;
            grow_line(state, style.line_height);
            index = index + decoded.size;
            continue;
        }

        // §16.6.1: a run of white space collapses to a single space, and one
        // at the start of a line is dropped.
        if is_space_byte(c) {
            while index < source_len
                && is_space_byte(dom_byte(doc, source_off, index)) {
                index = index + 1;
            }
            if !(*state).line_empty {
                (*state).pending_space = true;
            }
            continue;
        }

        let word_start: u64 = index;
        while index < source_len
            && !is_space_byte(dom_byte(doc, source_off, index)) {
            index = index + 1;
        }
        let word_len: u64 = index - word_start;
        let word: []const u8 =
            node.bytes(doc, source_off + word_start, word_len);

        // §16.6 breaks at spaces; UAX #14 finds the opportunities *inside* a
        // run of non-space text — after a hyphen, between two ideographs —
        // which is what lets a long CJK line wrap at all, and what stops a
        // wrap landing inside "3.5" or before a closing bracket.
        vec.clear(&breaks);
        collect_breaks(word, &breaks);

        let piece_start: u64 = 0;
        for step: u64 in 0..breaks.length {
            let piece_end: u64 = boundary(&breaks, step);
            if piece_end <= piece_start {
                continue;
            }
            let piece: []const u8 = subview(word, piece_start, piece_end);
            let piece_width: f64 = metrics.text_width(set, style, piece);
            let space_width: f64 = 0.0;
            if (*state).pending_space {
                space_width = metrics.codepoint_width(set, style, ' ' as u32);
            }

            let overflows: bool = !nowrap && !(*state).line_empty
                && (*state).x + space_width + piece_width
                    > (*state).origin_x + (*state).available;
            if overflows {
                first_fragment = flush_fragment(tree, styles, set, text_box,
                    state, fragment_start, fragment_width, first_fragment);
                break_line(tree, styles, set, state);
                fragment_start = box.text_length(tree);
                fragment_width = 0.0;
                (*state).pending_space = false;
                space_width = 0.0;
            }
            if (*state).pending_space {
                box.push_byte(tree, ' ');
                (*state).x = (*state).x + space_width;
                (*state).pending_space = false;
                if fragment_width == 0.0 && (*state).last_fragment != box.none() {
                    // Nothing accumulated here yet, so the space separates this
                    // fragment from the previous one and belongs to that one.
                    // It sits at the buffer's end, immediately after that
                    // fragment's bytes, so extending it is just a longer
                    // length.
                    let previous: LayoutBox =
                        box.get(tree, (*state).last_fragment);
                    previous.text_len = previous.text_len + 1;
                    previous.width = previous.width + space_width;
                    box.set(tree, (*state).last_fragment, previous);
                    fragment_start = box.text_length(tree);
                } else {
                    fragment_width = fragment_width + space_width;
                }
            }
            for byte: u64 in 0..len(piece) {
                box.push_byte(tree, piece[byte]);
            }
            fragment_width = fragment_width + piece_width;
            (*state).x = (*state).x + piece_width;
            (*state).line_empty = false;
            grow_line(state, style.line_height);
            piece_start = piece_end;
        }
    }
    flush_fragment(tree, styles, set, text_box, state, fragment_start,
        fragment_width, first_fragment);
    vec.destroy(&breaks);
}

// Every byte offset in `text` where UAX #14 allows a line to break, followed
// by the run's end so the caller can walk consecutive boundaries.
fn collect_breaks(text: []const u8, out: *Vec<u64>) -> void {
    let state: BreakState = linebreak.new_state();
    let index: u64 = 0;
    while index < len(text) {
        let decoded: TextChar = utf8.decode(text, index);
        let decision: u8 = linebreak.next(&state,
            linebreak.class_of(decoded.codepoint), decoded.codepoint);
        if index > 0 && decision != linebreak.break_prohibited() {
            vec.push(out, index);
        }
        index = index + decoded.size;
    }
    vec.push(out, len(text));
}

fn boundary(breaks: *Vec<u64>, index: u64) -> u64 {
    match vec.get(breaks, index) {
        Option<u64>.Some(value) => { return value; },
        Option<u64>.None => { return 0; },
    }
}

fn subview(view: []const u8, from: u64, to: u64) -> []const u8 {
    if to <= from || from >= len(view) {
        return slice(0 as *const u8, 0);
    }
    let end: u64 = to;
    if end > len(view) {
        end = len(view);
    }
    return slice((&view[from]) as *const u8, end - from);
}

fn dom_byte(doc: *DomDocument, offset: u64, index: u64) -> u8 {
    let view: []const u8 = node.bytes(doc, offset + index, 1);
    return view[0];
}

fn grow_line(state: *InlineState, line_height: f64) -> void {
    if line_height > (*state).line_height {
        (*state).line_height = line_height;
    }
}

// Emit the accumulated bytes as a positioned fragment. The first fragment of a
// text box reuses that box; later ones become new siblings. Returns the new
// value of the caller's `reuse` flag.
fn flush_fragment(
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    text_box: u64,
    state: *InlineState,
    fragment_start: u64,
    fragment_width: f64,
    reuse: bool
) -> bool {
    let length: u64 = box.text_length(tree) - fragment_start;
    if length == 0 {
        return reuse;
    }
    let template: LayoutBox = box.get(tree, text_box);
    let style: ComputedStyle = style_of(styles, template.style_node);
    let target: u64 = text_box;
    if !reuse {
        target = box.create(tree, box.box_text(), template.node,
            template.style_node);
        // Next to the fragment before it, so the fragments of one text node
        // stay together and in order. Appending at the end of the parent
        // instead would put them after boxes the inline walk has not reached
        // yet, and it would lay them out a second time.
        box.insert_after(tree, (*state).previous_fragment, target);
    }
    (*state).previous_fragment = target;
    let fragment: LayoutBox = box.get(tree, target);
    fragment.text_off = fragment_start;
    fragment.text_len = length;
    fragment.x = (*state).x - fragment_width;
    fragment.y = (*state).line_top;
    fragment.width = fragment_width;
    fragment.height = style.line_height;
    fragment.baseline = metrics.ascent(set, style);
    box.set(tree, target, fragment);
    grow_line(state, style.line_height);
    (*state).last_fragment = target;
    return false;
}

fn break_line(
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    state: *InlineState
) -> void {
    align_line(tree, styles, set, state);
    (*state).line_top = (*state).line_top + (*state).line_height;
    (*state).line_height = 0.0;
    (*state).line_empty = true;
    (*state).pending_space = false;
    (*state).last_fragment = box.none();
    // The next line may meet a different set of floats.
    apply_float_band(state);
    (*state).x = (*state).origin_x;
}

// Apply text-align to the fragments sitting on the current line.
fn align_line(
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    state: *InlineState
) -> void {
    let style: ComputedStyle =
        style_of(styles, box.get(tree, (*state).container).style_node);
    if style.text_align == computed.text_align_left()
        || style.text_align == computed.text_align_justify() {
        return;
    }
    let slack: f64 = (*state).available - ((*state).x - (*state).origin_x);
    if slack <= 0.0 {
        return;
    }
    let shift: f64 = slack;
    if style.text_align == computed.text_align_center() {
        shift = slack / 2.0;
    }
    shift_line(tree, (*state).container, (*state).line_top, shift);
}

fn shift_line(tree: *LayoutTree, parent: u64, line_top: f64, shift: f64) -> void {
    let child: u64 = box.get(tree, parent).first_child;
    while child != box.none() {
        let child_box: LayoutBox = box.get(tree, child);
        if child_box.kind == box.box_text() && child_box.y == line_top {
            child_box.x = child_box.x + shift;
            box.set(tree, child, child_box);
        } else if child_box.kind == box.box_inline() {
            shift_line(tree, child, line_top, shift);
        }
        child = child_box.next_sibling;
    }
}

// --- Entry point -------------------------------------------------------------

// Build and lay out `doc` into `tree` at the given viewport width.
pub fn layout(
    doc: *DomDocument,
    styles: *StyleTree,
    tree: *LayoutTree,
    set: *TextFontSet,
    images: *ImageStore,
    viewport_width: f64
) -> void {
    build(doc, styles, tree, images);
    if (*tree).root == box.none() {
        return;
    }
    // The root establishes the document's one block formatting context, so its
    // floats live here and are cleaned up with it.
    let context: FloatContext = floats.new_context();
    // The root's own margin collapses with its first child's, and the result
    // sits above the root — which is where the eight pixels at the top of an
    // unstyled page come from.
    let top: f64 =
        collapsed_top_margin(tree, styles, (*tree).root, viewport_width);
    layout_block(doc, tree, styles, set, &context, images, (*tree).root, 0.0,
        top, viewport_width, -1.0);
    // §10.6.3: a float does not make its containing block taller, but the
    // document still has to be tall enough to show it.
    let lowest: f64 = floats.lowest(&context);
    let root: LayoutBox = box.get(tree, (*tree).root);
    let bottom: f64 = root.y + box.border_box_height(root);
    if lowest > bottom {
        root.height = root.height + (lowest - bottom);
    }
    // The margin that escaped the bottom of the root is still part of the
    // document's height, so record it where document_height will find it.
    root.margin_bottom =
        collapsed_bottom_margin(tree, styles, (*tree).root, viewport_width);
    box.set(tree, (*tree).root, root);
    floats.destroy(&context);
}

// The total height the document occupies, for sizing a canvas.
pub fn document_height(tree: *LayoutTree) -> f64 {
    if (*tree).root == box.none() {
        return 0.0;
    }
    let root: LayoutBox = box.get(tree, (*tree).root);
    return root.y + box.border_box_height(root) + root.margin_bottom;
}
