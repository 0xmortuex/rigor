// Painting — CSS 2.1 Appendix E, "elaborate description of stacking contexts".
//
// The box tree is walked in tree order and each box paints its background,
// then its borders, then its text, then its children. That is the correct
// order for content in normal flow with no positioning, which is everything
// rigor lays out today; z-index and stacking contexts arrive with positioned
// elements and will reorder this walk rather than replace it.
//
// Text is drawn from the font's real outlines: each glyph is looked up through
// the font's cmap, its contours are flattened, and it is rasterized with
// anti-aliasing and composited in the text colour. Advances come from the same
// metrics layout measured with, so painted text lands exactly where layout put
// it. When no font is installed, the built-in 8x8 bitmap font is used instead,
// so the engine still draws something without a font file present.
module engine.paint.paint;

import canvas;
import font;
import engine.layout.box;
import engine.layout.metrics;
import engine.style.computed;
import engine.text.sfnt;
import engine.text.fonts;
import engine.text.cache;
import engine.text.utf8;

fn paint_background(
    target: *Canvas,
    current: LayoutBox,
    style: ComputedStyle
) -> void {
    // The background covers the padding box, which is the border box inset by
    // the border widths (CSS Backgrounds §3, `background-clip: border-box` is
    // the initial value, so in fact the whole border box).
    canvas.fill_rect(target, current.x, current.y,
        box.border_box_width(current), box.border_box_height(current),
        style.background_color);
}

fn paint_borders(
    target: *Canvas,
    current: LayoutBox,
    style: ComputedStyle
) -> void {
    let width: f64 = box.border_box_width(current);
    let height: f64 = box.border_box_height(current);
    if current.border_top > 0.0
        && style.border_top_style != computed.border_none() {
        canvas.fill_rect(target, current.x, current.y,
            width, current.border_top, style.border_top_color);
    }
    if current.border_bottom > 0.0
        && style.border_bottom_style != computed.border_none() {
        canvas.fill_rect(target, current.x,
            current.y + height - current.border_bottom,
            width, current.border_bottom, style.border_bottom_color);
    }
    if current.border_left > 0.0
        && style.border_left_style != computed.border_none() {
        canvas.fill_rect(target, current.x, current.y,
            current.border_left, height, style.border_left_color);
    }
    if current.border_right > 0.0
        && style.border_right_style != computed.border_none() {
        canvas.fill_rect(target, current.x + width - current.border_right,
            current.y, current.border_right, height, style.border_right_color);
    }
}

// Draw one glyph into a cell of `cell_width` x `cell_height`.
//
// The cell is sized from the advance layout measured, not from a fixed
// multiple of the 8x8 bitmap. The font is monospaced and layout is
// proportional, so a uniform scale would draw an 'i' as wide as an 'm' and
// every run would overflow its measured width. Stretching each glyph into its
// own advance keeps text aligned with the geometry, at the cost of distorting
// the shapes — which is the honest trade until real font rendering lands.
fn paint_glyph(
    target: *Canvas,
    code: u32,
    left: f64,
    top: f64,
    cell_width: f64,
    cell_height: f64,
    color: StyleColor
) -> void {
    let pixel_width: f64 = cell_width / (font.glyph_width() as f64);
    let pixel_height: f64 = cell_height / (font.glyph_height() as f64);
    for row: u64 in 0..font.glyph_height() {
        let bits: u8 = font.glyph_row(code, row);
        if bits == 0 as u8 {
            continue;
        }
        for column: u64 in 0..font.glyph_width() {
            if ((bits >> (column as u8)) & (1 as u8)) == 0 as u8 {
                continue;
            }
            canvas.fill_rect(target,
                left + (column as f64) * pixel_width,
                top + (row as f64) * pixel_height,
                pixel_width, pixel_height, color);
        }
    }
}

// Composite a cached glyph onto the canvas, scaling its coverage into the
// text colour's alpha.
fn blit_glyph(
    target: *Canvas,
    glyphs: *TextGlyphCache,
    entry: TextCachedGlyph,
    pen_x: f64,
    baseline_y: f64,
    color: StyleColor
) -> void {
    let origin_x: f64 = pen_x + entry.left;
    let origin_y: f64 = baseline_y + entry.top;
    for row: u64 in 0..entry.height {
        for column: u64 in 0..entry.width {
            let coverage: u8 = cache.coverage_at(glyphs, entry, column, row);
            if coverage == 0 as u8 {
                continue;
            }
            let alpha: u64 = (coverage as u64) * (color.a as u64) / 255;
            canvas.blend_pixel(target,
                (origin_x + (column as f64)) as u64,
                (origin_y + (row as f64)) as u64,
                computed.rgba(color.r, color.g, color.b, alpha as u8));
        }
    }
}

fn paint_text(
    target: *Canvas,
    tree: *LayoutTree,
    set: *TextFontSet,
    glyphs: *TextGlyphCache,
    current: LayoutBox,
    style: ComputedStyle
) -> void {
    if current.text_len == 0 {
        return;
    }
    let text: []const u8 = box.text_bytes(tree, current.text_off, current.text_len);
    let face: *TextFace = metrics.face_for(set, style);
    let baseline: f64 = current.y + current.baseline;

    if !sfnt.is_ok(face) {
        paint_text_bitmap(target, text, current.x, baseline, style);
        return;
    }

    let scale: f64 = metrics.scale_for(face, style.font_size);
    let pen: f64 = current.x;
    let index: u64 = 0;
    // The same kerning layout measured with, applied in the same order.
    let kern: bool = sfnt.has_kerning(face);
    let previous: u64 = 0;
    while index < len(text) {
        let decoded: TextChar = utf8.decode(text, index);
        let glyph: u64 = sfnt.glyph_for(face, decoded.codepoint as u64);
        if kern && previous != 0 {
            pen = pen + sfnt.kerning(face, previous, glyph) * scale;
        }
        // Glyph 0 is .notdef; drawing it would litter the page with boxes for
        // every unmapped character, so it is skipped and only the advance
        // applies.
        if glyph != 0 {
            let entry: TextCachedGlyph =
                cache.get(glyphs, face, glyph, style.font_size, scale);
            blit_glyph(target, glyphs, entry, pen, baseline, style.color);
        }
        pen = pen + sfnt.advance_for_glyph(face, glyph) * scale;
        previous = glyph;
        index = index + decoded.size;
    }
}

// The no-font fallback: the built-in 8x8 bitmap, stretched into each measured
// advance so it still lines up with the geometry layout produced.
fn paint_text_bitmap(
    target: *Canvas,
    text: []const u8,
    start_x: f64,
    baseline: f64,
    style: ComputedStyle
) -> void {
    let cell_height: f64 = style.font_size;
    let top: f64 = baseline - cell_height * 0.875;
    let pen: f64 = start_x;
    for index: u64 in 0..len(text) {
        let c: u8 = text[index];
        if (c & (0xC0 as u8)) == 0x80 as u8 {
            continue;
        }
        let advance: f64 = estimate_advance(c, style.font_size);
        if c > 32 as u8 && c < 127 as u8 {
            paint_glyph(target, c as u32, pen, top, advance, cell_height,
                style.color);
        }
        pen = pen + advance;
    }
}

// Mirrors the estimate table in engine.layout.metrics, so the fallback path
// paints at the same advances it measured.
fn estimate_advance(c: u8, font_size: f64) -> f64 {
    if c == ' ' { return 0.26 * font_size; }
    if c == 'i' || c == 'l' || c == 'j' || c == '.' || c == ',' || c == ':'
        || c == ';' || c == 39 as u8 || c == '|' || c == '!' {
        return 0.24 * font_size;
    }
    if c == 'f' || c == 't' || c == 'r' || c == 'I' || c == '(' || c == ')'
        || c == '[' || c == ']' || c == '-' || c == '"' {
        return 0.33 * font_size;
    }
    if c == 'm' || c == 'w' || c == 'M' || c == 'W' { return 0.83 * font_size; }
    if c >= 'A' && c <= 'Z' { return 0.62 * font_size; }
    if c >= '0' && c <= '9' { return 0.56 * font_size; }
    if c >= 'a' && c <= 'z' { return 0.53 * font_size; }
    return 0.55 * font_size;
}

fn paint_box(
    target: *Canvas,
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet,
    glyphs: *TextGlyphCache,
    index: u64
) -> void {
    let current: LayoutBox = box.get(tree, index);
    let style: ComputedStyle = computed.get(styles, current.style_node);

    // `visibility: hidden` keeps the box in the flow and paints nothing of it.
    // It inherits, so a visible descendant of a hidden box can still paint —
    // which is why this skips the box rather than the subtree.
    if !style.visible {
        // Fall through to the children, each of which decides for itself.
    } else if current.kind == box.box_text() {
        paint_text(target, tree, set, glyphs, current, style);
    } else if current.kind != box.box_anonymous() {
        // Anonymous boxes have no style of their own to paint; their content
        // is painted by their children.
        paint_background(target, current, style);
        paint_borders(target, current, style);
    }

    let child: u64 = current.first_child;
    while child != box.none() {
        paint_box(target, tree, styles, set, glyphs, child);
        child = box.get(tree, child).next_sibling;
    }
}

// Paint the whole document onto `target`, over an opaque white canvas — the
// initial containing block's background, which the spec propagates from the
// root element and which rigor does not yet implement, so white is used.
pub fn paint(
    target: *Canvas,
    tree: *LayoutTree,
    styles: *StyleTree,
    set: *TextFontSet
) -> void {
    canvas.fill_all(target,
        computed.rgba(255 as u8, 255 as u8, 255 as u8, 255 as u8));
    if (*tree).root == box.none() {
        return;
    }
    // The cache lives for one paint. A page reuses each glyph many times
    // within a single render, which is where the win is; keeping it across
    // renders would need the caller to own it and matters only once
    // incremental repaint exists.
    let glyphs: TextGlyphCache = cache.new_cache();
    paint_box(target, tree, styles, set, &glyphs, (*tree).root);
    cache.destroy(&glyphs);
}
