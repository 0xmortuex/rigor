// Serialize a canvas as a BMP file.
//
// BMP is chosen because it needs no compression and no external library: a
// 54-byte header followed by raw pixel rows. That keeps "can rigor produce an
// image?" answerable without a window, a font library or a PNG encoder, and
// makes rendering diffable in tests.
//
// The format stores rows bottom-up by default, which is why the writer walks
// the canvas backwards. Pixels are already BGRA in memory — the order BMP
// wants — so each row is copied rather than converted.
module engine.paint.bmp;

import std.vec;
import canvas;

fn push_u16(out: *Vec<u8>, value: u64) -> void {
    vec.push(out, (value & (0xFF as u64)) as u8);
    vec.push(out, ((value >> 8) & (0xFF as u64)) as u8);
}

fn push_u32(out: *Vec<u8>, value: u64) -> void {
    vec.push(out, (value & (0xFF as u64)) as u8);
    vec.push(out, ((value >> 8) & (0xFF as u64)) as u8);
    vec.push(out, ((value >> 16) & (0xFF as u64)) as u8);
    vec.push(out, ((value >> 24) & (0xFF as u64)) as u8);
}

// Encode `target` as a 32-bit BMP in a fresh owned buffer, which the caller
// must eventually vec.destroy.
pub fn encode(target: *Canvas) -> Vec<u8> {
    let width: u64 = canvas.width(target);
    let height: u64 = canvas.height(target);
    let pixel_bytes: u64 = width * height * 4;
    let header_size: u64 = 54;

    let out: Vec<u8> = vec.with_capacity<u8>(header_size + pixel_bytes + 1);

    // BITMAPFILEHEADER.
    vec.push(&out, 'B');
    vec.push(&out, 'M');
    push_u32(&out, header_size + pixel_bytes);
    push_u16(&out, 0);
    push_u16(&out, 0);
    push_u32(&out, header_size);

    // BITMAPINFOHEADER. A negative height would mean top-down rows; rows are
    // written bottom-up instead so the header stays the conventional form.
    push_u32(&out, 40);
    push_u32(&out, width);
    push_u32(&out, height);
    push_u16(&out, 1);
    push_u16(&out, 32);
    push_u32(&out, 0);
    push_u32(&out, pixel_bytes);
    push_u32(&out, 2835);
    push_u32(&out, 2835);
    push_u32(&out, 0);
    push_u32(&out, 0);

    // Rows, bottom-up. A 32-bit BMP needs no row padding: every row is already
    // a whole number of 4-byte pixels.
    let source: *u8 = canvas.pixels(target);
    let row: u64 = height;
    while row > 0 {
        row = row - 1;
        let start: u64 = row * width * 4;
        for index: u64 in 0..(width * 4) {
            vec.push(&out, source[start + index]);
        }
    }
    return move out;
}
