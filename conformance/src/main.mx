// rigor-conformance — batch tokenizer driver for the html5lib-tests suites.
//
// Reads one JSON job object on stdin:
//
//     {"cases":[{"input":"…","state":"RCDATA","lastStartTag":"xmp"}, …]}
//
// and writes one JSON result per line on stdout, in the same order:
//
//     {"tokens":[["Character","foo"],["EndTag","xmp"]],"errors":["eof-in-tag"]}
//
// Token shapes match html5lib's expected-output format exactly, so the Python
// driver (tools/run_conformance.py) can compare parsed JSON to parsed JSON.
// Output is pure ASCII — every non-ASCII code point is written as a \uXXXX
// escape (surrogate pairs above the BMP) — which keeps the pipe encoding-safe
// on Windows.

import std.vec;
import std.json;
import engine.html.preprocess;
import engine.html.tokenizer;
import engine.html.tokens;
import engine.html.treebuilder;
import engine.dom.node;
import engine.dom.serialize;

extern fn getchar() -> c_int;
extern fn putchar(character: c_int) -> c_int;

fn read_stdin() -> Vec<u8> {
    let buf: Vec<u8> = vec.with_capacity<u8>(65536);
    loop {
        let c: c_int = getchar();
        if c < 0 {
            break;
        }
        vec.push(&buf, c as u8);
    }
    return move buf;
}

fn put(text: *u8) -> void {
    let index: u64 = 0;
    while text[index] != 0 as u8 {
        putchar(text[index] as c_int);
        index = index + 1;
    }
}

fn put_byte(b: u8) -> void {
    putchar(b as c_int);
}

fn hex_digit(value: u32) -> u8 {
    if value < 10 as u32 {
        return ('0' as u8) + (value as u8);
    }
    return ('a' as u8) + ((value - 10 as u32) as u8);
}

fn put_u16_escape(value: u32) -> void {
    put("\\u");
    put_byte(hex_digit((value >> 12) & (0xF as u32)));
    put_byte(hex_digit((value >> 8) & (0xF as u32)));
    put_byte(hex_digit((value >> 4) & (0xF as u32)));
    put_byte(hex_digit(value & (0xF as u32)));
}

fn put_codepoint(cp: u32) -> void {
    if cp < 0x10000 as u32 {
        put_u16_escape(cp);
        return;
    }
    let rest: u32 = cp - (0x10000 as u32);
    put_u16_escape((0xD800 as u32) + (rest >> 10));
    put_u16_escape((0xDC00 as u32) + (rest & (0x3FF as u32)));
}

// How many continuation bytes follow this UTF-8 lead byte? 0 when the byte is
// not a valid lead.
fn utf8_extra(lead: u8) -> u64 {
    if lead >= 0xF0 as u8 && lead <= 0xF4 as u8 { return 3; }
    if lead >= 0xE0 as u8 && lead <= 0xEF as u8 { return 2; }
    if lead >= 0xC2 as u8 && lead <= 0xDF as u8 { return 1; }
    return 0;
}

// Write `view` as a JSON string literal, escaping to pure ASCII. Malformed
// UTF-8 is replaced with U+FFFD, matching what a decoder would have produced.
fn put_json_string(view: []const u8) -> void {
    put_byte('"');
    let index: u64 = 0;
    let total: u64 = len(view);
    while index < total {
        let c: u8 = view[index];
        if c == '"' {
            put("\\\"");
            index = index + 1;
        } else if c == 92 as u8 {
            put("\\\\");
            index = index + 1;
        } else if c == 10 as u8 {
            put("\\n");
            index = index + 1;
        } else if c == 13 as u8 {
            put("\\r");
            index = index + 1;
        } else if c == 9 as u8 {
            put("\\t");
            index = index + 1;
        } else if c < 0x20 as u8 {
            put_u16_escape(c as u32);
            index = index + 1;
        } else if c < 0x80 as u8 {
            put_byte(c);
            index = index + 1;
        } else {
            let extra: u64 = utf8_extra(c);
            if extra == 0 || index + extra >= total {
                put_codepoint(0xFFFD as u32);
                index = index + 1;
            } else {
                let cp: u32 = 0 as u32;
                if extra == 1 {
                    cp = (c & (0x1F as u8)) as u32;
                } else if extra == 2 {
                    cp = (c & (0x0F as u8)) as u32;
                } else {
                    cp = (c & (0x07 as u8)) as u32;
                }
                let valid: bool = true;
                for step: u64 in 1..(extra + 1) {
                    let cont: u8 = view[index + step];
                    if (cont & (0xC0 as u8)) != 0x80 as u8 {
                        valid = false;
                    }
                    cp = (cp << 6) | ((cont & (0x3F as u8)) as u32);
                }
                if valid {
                    put_codepoint(cp);
                } else {
                    put_codepoint(0xFFFD as u32);
                }
                index = index + 1 + extra;
            }
        }
    }
    put_byte('"');
}

fn put_pool(sink: *HtmlTokenSink, off: u64, length: u64) -> void {
    put_json_string(tokens.pool_bytes(sink, off, length));
}

fn put_token(sink: *HtmlTokenSink, index: u64) -> void {
    let token: HtmlToken = tokens.get_token(sink, index);
    if token.kind == tokens.kind_chars() {
        put("[\"Character\",");
        put_pool(sink, token.data_off, token.data_len);
        put("]");
    } else if token.kind == tokens.kind_start_tag() {
        put("[\"StartTag\",");
        put_pool(sink, token.data_off, token.data_len);
        put(",{");
        for a: u64 in 0..token.attr_count {
            if a > 0 {
                put(",");
            }
            let attr: HtmlAttr = tokens.get_attr(sink, token.attr_first + a);
            put_pool(sink, attr.name_off, attr.name_len);
            put(":");
            put_pool(sink, attr.value_off, attr.value_len);
        }
        put("}");
        if token.self_closing {
            put(",true");
        }
        put("]");
    } else if token.kind == tokens.kind_end_tag() {
        put("[\"EndTag\",");
        put_pool(sink, token.data_off, token.data_len);
        put("]");
    } else if token.kind == tokens.kind_comment() {
        put("[\"Comment\",");
        put_pool(sink, token.data_off, token.data_len);
        put("]");
    } else {
        put("[\"DOCTYPE\",");
        if token.has_name {
            put_pool(sink, token.data_off, token.data_len);
        } else {
            put("null");
        }
        put(",");
        if token.has_public {
            put_pool(sink, token.public_off, token.public_len);
        } else {
            put("null");
        }
        put(",");
        if token.has_system {
            put_pool(sink, token.system_off, token.system_len);
        } else {
            put("null");
        }
        if token.force_quirks {
            put(",false]");
        } else {
            put(",true]");
        }
    }
}

fn state_code(view: []const u8) -> u32 {
    // 0 data, 1 RCDATA, 2 RAWTEXT, 3 PLAINTEXT.
    if len(view) == 0 {
        return 0 as u32;
    }
    let first: u8 = view[0];
    if first == 'R' {
        if len(view) > 1 && view[1] == 'C' {
            return 1 as u32;
        }
        return 2 as u32;
    }
    if first == 'P' {
        return 3 as u32;
    }
    return 0 as u32;
}

// Taking `&view[0]` is bounds-checked, so an empty test input would trap.
fn slice_ptr(view: []const u8) -> *const u8 {
    if len(view) == 0 {
        return 0 as *const u8;
    }
    return &view[0];
}

fn run_case(doc: *Document, case_index: u64) -> void {
    let source: []const u8 = slice(0 as *const u8, 0);
    let state: u32 = 0 as u32;
    let last_tag: []const u8 = slice(0 as *const u8, 0);

    match json.object_get(doc, case_index, "input") {
        Option<u64>.Some(node) => { source = json.as_string(doc, node); },
        Option<u64>.None => {},
    }
    match json.object_get(doc, case_index, "state") {
        Option<u64>.Some(node) => { state = state_code(json.as_string(doc, node)); },
        Option<u64>.None => {},
    }
    match json.object_get(doc, case_index, "lastStartTag") {
        Option<u64>.Some(node) => { last_tag = json.as_string(doc, node); },
        Option<u64>.None => {},
    }

    // The suite feeds an already-decoded character stream, so preprocessing
    // runs without the byte stream decoder's BOM removal.
    let sink: HtmlTokenSink = tokens.new_sink();
    let normalized: Vec<u8> =
        preprocess.normalize(slice_ptr(source), len(source), &sink);
    let t: HtmlTokenizer =
        tokenizer.new(normalized.data as *const u8, normalized.length);
    if len(last_tag) > 0 {
        tokenizer.set_last_start_tag(&t, &sink, slice_ptr(last_tag), len(last_tag));
    }
    if state == 1 as u32 {
        tokenizer.set_rcdata(&t);
    } else if state == 2 as u32 {
        tokenizer.set_rawtext(&t);
    } else if state == 3 as u32 {
        tokenizer.set_plaintext(&t);
    }
    tokenizer.run(&t, &sink);

    put("{\"tokens\":[");
    let emitted: u64 = 0;
    let count: u64 = tokens.token_count(&sink);
    for index: u64 in 0..count {
        let token: HtmlToken = tokens.get_token(&sink, index);
        if token.kind != tokens.kind_eof() {
            if emitted > 0 {
                put(",");
            }
            put_token(&sink, index);
            emitted = emitted + 1;
        }
    }
    put("],\"errors\":[");
    let errors: u64 = tokens.error_count(&sink);
    for index: u64 in 0..errors {
        if index > 0 {
            put(",");
        }
        let e: HtmlParseError = tokens.get_error(&sink, index);
        put("\"");
        put(tokens.error_name(e.code));
        put("\"");
    }
    put("]}");
    put_byte(10 as u8);

    tokens.destroy(&sink);
    vec.destroy(&normalized);
}

// Tree-construction mode: parse the case's input into a DOM and emit the
// html5lib tree serialization as a single JSON string, so the Python driver
// can compare it line for line against the .dat file's #document section.
fn run_tree_case(doc: *Document, case_index: u64) -> void {
    let source: []const u8 = slice(0 as *const u8, 0);
    match json.object_get(doc, case_index, "input") {
        Option<u64>.Some(entry) => { source = json.as_string(doc, entry); },
        Option<u64>.None => {},
    }
    let sink: HtmlTokenSink = tokens.new_sink();
    let normalized: Vec<u8> =
        preprocess.normalize(slice_ptr(source), len(source), &sink);
    let tree: DomDocument = node.new_document();
    treebuilder.parse(
        normalized.data as *const u8, normalized.length, &tree, &sink);
    let text: Vec<u8> = serialize.document(&tree);

    put("{\"tree\":");
    put_json_string(vec.as_const_slice(&text));
    put("}");
    put_byte(10 as u8);

    vec.destroy(&text);
    node.destroy(&tree);
    tokens.destroy(&sink);
    vec.destroy(&normalized);
}

fn main() -> int {
    let raw: Vec<u8> = read_stdin();
    let doc: Document = json.parse(raw.data as *const u8, raw.length);
    if !json.ok(&doc) {
        put("{\"fatal\":\"job json did not parse\"}");
        put_byte(10 as u8);
        return 1;
    }
    let root: u64 = json.root(&doc);
    let tree_mode: bool = false;
    match json.object_get(&doc, root, "mode") {
        Option<u64>.Some(entry) => {
            let mode: []const u8 = json.as_string(&doc, entry);
            tree_mode = len(mode) > 0 && mode[0] == 't';
        },
        Option<u64>.None => {},
    }
    if tree_mode {
        match json.object_get(&doc, root, "cases") {
            Option<u64>.Some(cases) => {
                let total: u64 = json.array_len(&doc, cases);
                for index: u64 in 0..total {
                    match json.array_get(&doc, cases, index) {
                        Option<u64>.Some(entry) => { run_tree_case(&doc, entry); },
                        Option<u64>.None => {},
                    }
                }
            },
            Option<u64>.None => {
                put("{\"fatal\":\"job json has no cases array\"}");
                put_byte(10 as u8);
                return 1;
            },
        }
        return 0;
    }
    match json.object_get(&doc, root, "cases") {
        Option<u64>.Some(cases) => {
            let total: u64 = json.array_len(&doc, cases);
            for index: u64 in 0..total {
                match json.array_get(&doc, cases, index) {
                    Option<u64>.Some(entry) => { run_case(&doc, entry); },
                    Option<u64>.None => {},
                }
            }
        },
        Option<u64>.None => {
            put("{\"fatal\":\"job json has no cases array\"}");
            put_byte(10 as u8);
            return 1;
        },
    }
    return 0;
}
